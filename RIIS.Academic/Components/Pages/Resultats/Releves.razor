@page "/releves"
@inject IRelevesNotesService RelevesNotesService
@inject IReleveNotePdfExportService ReleveNotePdfExportService
@inject IReferentielsService ReferentielsService
@inject IClassesPedagogiquesService ClassesPedagogiquesService
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject DialogService DialogService

<RadzenStack Gap="1rem">
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
            <RadzenStack Gap="0">
                <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0" Text="Relevés de notes" />
                <RadzenText Text="Liste des relevés annuels disponibles, avec recherche par étudiant et export Word individuel." />
            </RadzenStack>
            <RadzenIcon Icon="description" Style="font-size: 2.75rem" />
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenText TextStyle="TextStyle.H6" Text="Filtres de recherche" />

            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Parcours académique" Style="width:100%">
                        <RadzenDropDown Data="@parcoursAcademiques"
                                        TextProperty="Libelle"
                                        ValueProperty="Id"
                                        @bind-Value="@selectedParcoursAcademiqueId"
                                        Change="@OnParcoursFilterChanged"
                                        AllowClear="true"
                                        AllowFiltering="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        Placeholder="Tous les parcours"
                                        Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenFormField Text="Classe pédagogique" Style="width:100%">
                        <RadzenDropDown Data="@classes"
                                        TextProperty="Libelle"
                                        ValueProperty="Id"
                                        @bind-Value="@selectedClassePedagogiqueId"
                                        Change="@OnFilterChanged"
                                        AllowClear="true"
                                        AllowFiltering="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        Placeholder="Toutes les classes"
                                        Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="8">
                    <RadzenFormField Text="Recherche étudiant" Style="width:100%">
                        <RadzenTextBox @bind-Value="@searchText"
                                       Change="@OnSearchChanged"
                                       Placeholder="Nom, prénoms ou matricule"
                                       Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" JustifyContent="JustifyContent.End" Gap="0.5rem" Style="height:100%">
                        <RadzenButton Text="Rechercher" Icon="search" ButtonStyle="ButtonStyle.Primary" Click="@Load" />
                        <RadzenButton Text="Réinitialiser" Icon="restart_alt" ButtonStyle="ButtonStyle.Light" Click="@ResetFilters" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="0.75rem">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
                <RadzenText TextStyle="TextStyle.H6" class="rz-m-0" Text="@($"Relevés trouvés : {filteredItems.Count}")" />
                <RadzenText TextStyle="TextStyle.Caption" Text="Le bouton Word génère le relevé annuel de l'étudiant sélectionné." />
            </RadzenStack>

            <RadzenDataGrid @ref="relevesGrid" Data="@filteredItems" TItem="ReleveNoteEtudiantDisponibleDto" AllowPaging="true" AllowSorting="true" AllowColumnResize="true" PageSize="10">
                <Columns>
                    <RadzenDataGridColumn TItem="ReleveNoteEtudiantDisponibleDto" Property="Matricule" Title="Matricule" Width="150px" />
                    <RadzenDataGridColumn TItem="ReleveNoteEtudiantDisponibleDto" Property="EtudiantNomComplet" Title="Étudiant" />
                    <RadzenDataGridColumn TItem="ReleveNoteEtudiantDisponibleDto" Property="ParcoursLibelle" Title="Parcours" />
                    <RadzenDataGridColumn TItem="ReleveNoteEtudiantDisponibleDto" Property="NiveauLibelle" Title="Niveau" Width="160px" />
                    <RadzenDataGridColumn TItem="ReleveNoteEtudiantDisponibleDto" Property="AnneeAcademiqueLibelle" Title="Année" Width="140px" />
                    <RadzenDataGridColumn TItem="ReleveNoteEtudiantDisponibleDto" Title="Actions" Width="500px" Sortable="false" Filterable="false">
                        <Template Context="item">
                            <RadzenButton Text="Aperçu"
                                          Icon="visibility"
                                          Size="ButtonSize.Small"
                                          ButtonStyle="ButtonStyle.Light"
                                          Click="@(() => Preview(item))" />
                            <RadzenButton Text="Page"
                                          Icon="open_in_new"
                                          Size="ButtonSize.Small"
                                          ButtonStyle="ButtonStyle.Light"
                                          class="rz-ml-1"
                                          Click="@(() => OpenPreviewPage(item))" />
                            <RadzenButton Text="Word"
                                          Icon="download"
                                          Size="ButtonSize.Small"
                                          ButtonStyle="ButtonStyle.Primary"
                                          class="rz-ml-1"
                                          Click="@(() => ExportWord(item))" />
                            <RadzenButton Text="PDF"
                                          Icon="picture_as_pdf"
                                          Size="ButtonSize.Small"
                                          ButtonStyle="ButtonStyle.Danger"
                                          class="rz-ml-1"
                                          Click="@(() => ExportPdf(item))" />
                            <RadzenButton Text="Aperçu PDF"
                                          Icon="preview"
                                          Size="ButtonSize.Small"
                                          ButtonStyle="ButtonStyle.Light"
                                          class="rz-ml-1"
                                          Click="@(() => PreviewPdf(item))" />
                            <RadzenButton Text="Modèle"
                                          Icon="article"
                                          Size="ButtonSize.Small"
                                          ButtonStyle="ButtonStyle.Secondary"
                                          class="rz-ml-1"
                                          Click="@(() => ExportTemplateWord(item))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenStack>
    </RadzenCard>

    @if (selectedReleve is not null)
    {
        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
                    <RadzenStack Gap="0">
                        <RadzenText TextStyle="TextStyle.H5" class="rz-m-0" Text="@selectedReleve.Titre" />
                        <RadzenText Text="@($"{selectedReleve.EtudiantNomComplet} - {selectedReleve.Matricule}")" />
                    </RadzenStack>

                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                        <RadzenButton Text="Ouvrir en page"
                                      Icon="open_in_new"
                                      ButtonStyle="ButtonStyle.Light"
                                      Click="@(() => OpenPreviewPage(selectedReleve.DossierAcademiqueId))" />
                        <RadzenButton Text="Exporter ce relevé"
                                      Icon="download"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Click="@(() => ExportWord(selectedReleve.DossierAcademiqueId))" />
                        <RadzenButton Text="Exporter PDF"
                                      Icon="picture_as_pdf"
                                      ButtonStyle="ButtonStyle.Danger"
                                      Click="@(() => ExportPdf(selectedReleve.DossierAcademiqueId))" />
                        <RadzenButton Text="Aperçu PDF"
                                      Icon="preview"
                                      ButtonStyle="ButtonStyle.Light"
                                      Click="@(() => PreviewPdf(selectedReleve))" />
                        <RadzenButton Text="Exporter modèle"
                                      Icon="article"
                                      ButtonStyle="ButtonStyle.Secondary"
                                      Click="@(() => ExportTemplateWord(selectedReleve.DossierAcademiqueId))" />
                    </RadzenStack>
                </RadzenStack>

                @if (!string.IsNullOrWhiteSpace(selectedReleve.QrCodeDataUrl))
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                        <img src="@selectedReleve.QrCodeDataUrl"
                             alt="QR code du relevé"
                             title="QR code du relevé"
                             width="120"
                             height="120"
                             style="display:block; border:1px solid var(--rz-border-color); padding:0.25rem; background:#fff;" />
                        <RadzenText TextStyle="TextStyle.Caption" Text="Identification du relevé" />
                    </RadzenStack>
                }

                <RadzenRow>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenText TextStyle="TextStyle.Subtitle2" Text="Parcours" />
                        <RadzenText Text="@selectedReleve.FiliereLibelle" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenText TextStyle="TextStyle.Subtitle2" Text="Spécialité" />
                        <RadzenText Text="@(selectedReleve.SpecialiteLibelle ?? "-")" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenText TextStyle="TextStyle.Subtitle2" Text="Décision annuelle" />
                        <RadzenText Text="@selectedReleve.DecisionMention" />
                    </RadzenColumn>
                </RadzenRow>

                @foreach (var semestre in selectedReleve.Semestres.OrderBy(x => x.Numero))
                {
                    <RadzenPanel Text="@($"{semestre.Libelle} - Moyenne : {FormatNote(semestre.Moyenne)} - Crédits : {FormatCredit(semestre.CreditsCapitalises)}/{FormatCredit(semestre.CreditsAttendus)}")"
                                 AllowCollapse="true"
                                 Collapsed="true">
                        <RadzenDataGrid Data="@semestre.Lignes" TItem="ReleveNoteLigneDto" AllowPaging="true" PageSize="8" AllowSorting="true" AllowColumnResize="true">
                            <Columns>
                                <RadzenDataGridColumn TItem="ReleveNoteLigneDto" Property="UniteEnseignementLibelle" Title="UE (Unité d'enseignement)" />
                                <RadzenDataGridColumn TItem="ReleveNoteLigneDto" Property="ElementConstitutifCode" Title="Code" Width="110px" />
                                <RadzenDataGridColumn TItem="ReleveNoteLigneDto" Property="ElementConstitutifLibelle" Title="EC (Élément constitutif)" />
                                <RadzenDataGridColumn TItem="ReleveNoteLigneDto" Property="Session" Title="Session" Width="100px" />
                                <RadzenDataGridColumn TItem="ReleveNoteLigneDto" Title="Note/20" Width="110px">
                                    <Template Context="ligne">@FormatNote(ligne.NoteSur20)</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="ReleveNoteLigneDto" Property="Decision" Title="Décision" Width="110px" />
                                <RadzenDataGridColumn TItem="ReleveNoteLigneDto" Title="Crédit" Width="110px">
                                    <Template Context="ligne">@FormatCredit(ligne.CreditsCapitalises)</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="ReleveNoteLigneDto" Property="Grade" Title="Grade" Width="90px" />
                            </Columns>
                        </RadzenDataGrid>
                    </RadzenPanel>
                }
            </RadzenStack>
        </RadzenCard>
    }

</RadzenStack>

    @code {
    private List<ReleveNoteEtudiantDisponibleDto> items = [];
    private List<ReleveNoteEtudiantDisponibleDto> filteredItems = [];
    private RadzenDataGrid<ReleveNoteEtudiantDisponibleDto>? relevesGrid;
    private List<LookupDto> parcoursAcademiques = [];
    private List<LookupDto> classes = [];
    private ReleveNoteAnnuelDto? selectedReleve;
    private long? selectedParcoursAcademiqueId;
    private long? selectedClassePedagogiqueId;
    private string? searchText;

    protected override async Task OnInitializedAsync()
    {
        await LoadLookups();
        await Load();
    }

    private async Task LoadLookups()
    {
        parcoursAcademiques = (await ReferentielsService.GetParcoursAcademiquesAsync(inclureInactifs: false))
            .Select(x => new LookupDto
            {
                Id = x.Id,
                Libelle = string.IsNullOrWhiteSpace(x.Code) ? x.Libelle : $"{x.Code} - {x.Libelle}"
            })
            .ToList();
        await RefreshClassesLookup();
    }

    private async Task Load()
    {
        items = await RelevesNotesService.GetEtudiantsDisponiblesAsync(
            parcoursAcademiqueId: selectedParcoursAcademiqueId,
            classePedagogiqueId: selectedClassePedagogiqueId);

        ApplySearch();
        if (relevesGrid is not null) await relevesGrid.Reload();
    }

    private async Task RefreshClassesLookup()
    {
        classes = (await ClassesPedagogiquesService.GetClassesPedagogiquesAsync())
            .Where(x => selectedParcoursAcademiqueId is null
                || x.ParcoursAcademiqueId == selectedParcoursAcademiqueId)
            .OrderBy(x => x.Libelle)
            .Select(x => new LookupDto { Id = x.Id, Libelle = x.Libelle })
            .ToList();
    }

    private async Task OnParcoursFilterChanged(object? _)
    {
        await RefreshClassesLookup();

        if (selectedClassePedagogiqueId is not null && classes.All(x => x.Id != selectedClassePedagogiqueId))
        {
            selectedClassePedagogiqueId = null;
        }

        selectedReleve = null;
        await Load();
    }

    private async Task OnFilterChanged(object? _)
    {
        await RefreshClassesLookup();

        if (selectedClassePedagogiqueId is not null && classes.All(x => x.Id != selectedClassePedagogiqueId))
        {
            selectedClassePedagogiqueId = null;
        }

        selectedReleve = null;
        await Load();
    }

    private async Task OnSearchChanged(object? _)
    {
        ApplySearch();
        if (relevesGrid is not null) await relevesGrid.Reload();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ResetFilters()
    {
        selectedParcoursAcademiqueId = null;
        selectedClassePedagogiqueId = null;
        searchText = null;
        selectedReleve = null;

        await LoadLookups();
        await Load();
    }

    private async Task Preview(ReleveNoteEtudiantDisponibleDto item)
    {
        try
        {
            selectedReleve = await RelevesNotesService.GenererReleveAnnuelAsync(item.DossierAcademiqueId);
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
    }

    private void OpenPreviewPage(ReleveNoteEtudiantDisponibleDto item)
        => OpenPreviewPage(item.DossierAcademiqueId);

    private void OpenPreviewPage(long dossierAcademiqueId)
        => Navigation.NavigateTo($"/releves/{dossierAcademiqueId}");

    private void ExportWord(ReleveNoteEtudiantDisponibleDto item)
        => ExportWord(item.DossierAcademiqueId);

    private void ExportWord(long dossierAcademiqueId)
        => Navigation.NavigateTo($"/exports/releves/{dossierAcademiqueId}.docx", forceLoad: true);

    private void ExportPdf(ReleveNoteEtudiantDisponibleDto item)
        => ExportPdf(item.DossierAcademiqueId);

    private void ExportPdf(long dossierAcademiqueId)
        => Navigation.NavigateTo($"/exports/releves/{dossierAcademiqueId}.pdf", forceLoad: true);

    private async Task PreviewPdf(ReleveNoteEtudiantDisponibleDto item)
        => await PreviewPdf(item.DossierAcademiqueId, item.EtudiantNomComplet);

    private async Task PreviewPdf(ReleveNoteAnnuelDto releve)
        => await PreviewPdf(releve.DossierAcademiqueId, releve.EtudiantNomComplet);

    private async Task PreviewPdf(long dossierAcademiqueId, string studentName)
    {
        try
        {
            var export = await ReleveNotePdfExportService.ExporterReleveAnnuelAsync(
                dossierAcademiqueId,
                CancellationToken.None);

            if (export is null)
            {
                NotifyError("Le relevé PDF ne peut pas être généré pour cet étudiant.");
                return;
            }

            var pdfDataUrl = $"data:{export.ContentType};base64,{Convert.ToBase64String(export.Content)}";
            await DialogService.OpenAsync<RelevePdfPreviewDialog>(
                $"Aperçu PDF - {studentName}",
                new Dictionary<string, object?>
                {
                    [nameof(RelevePdfPreviewDialog.PdfUrl)] = pdfDataUrl
                },
                new DialogOptions
                {
                    Width = "95vw",
                    Height = "95vh",
                    Resizable = true,
                    Draggable = true,
                    CloseDialogOnOverlayClick = true
                });
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
    }

    private void ExportTemplateWord(ReleveNoteEtudiantDisponibleDto item)
        => ExportTemplateWord(item.DossierAcademiqueId);

    private void ExportTemplateWord(long dossierAcademiqueId)
        => Navigation.NavigateTo($"/exports/releves/{dossierAcademiqueId}.modele.docx", forceLoad: true);

    private void ApplySearch()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            filteredItems = items;
            return;
        }

        var term = searchText.Trim();
        filteredItems = items
            .Where(x => Contains(x.EtudiantNomComplet, term)
                || Contains(x.Matricule, term))
            .ToList();
    }

    private static bool Contains(string value, string term)
        => value.Contains(term, StringComparison.OrdinalIgnoreCase);

    private static string FormatNote(decimal? value)
        => value is null ? "-" : value.Value.ToString("0.##", CultureInfo.InvariantCulture);

    private static string FormatCredit(decimal value)
        => value == decimal.Truncate(value)
            ? value.ToString("00", CultureInfo.InvariantCulture)
            : value.ToString("0.##", CultureInfo.InvariantCulture);

    private void NotifyError(string message)
        => NotificationService.Notify(NotificationSeverity.Error, "Erreur", message);
}
