@page "/etudiants"
@inject IEtudiantsService EtudiantsService
@inject IReferentielsService ReferentielsService
@inject IDossierEtudiantService DossierEtudiantService
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject AuthenticationStateProvider AuthenticationStateProvider

<RadzenStack Gap="1rem">
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
            <RadzenStack Gap="0">
                <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0" Text="Étudiants" />
                <RadzenText Text="Gestion du dossier permanent des étudiants." />
            </RadzenStack>
            <RadzenButton Text="Nouvel étudiant" Icon="person_add" Click="@Create" ButtonStyle="ButtonStyle.Primary" />
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.75rem" Wrap="FlexWrap.Wrap">
                <RadzenFormField Text="Recherche" Style="width: min(100%, 520px)">
                    <RadzenTextBox @bind-Value="@searchText" Placeholder="Nom ou prénoms..." />
                </RadzenFormField>
                <RadzenButton Text="Rechercher" Icon="search" Click="@Search" />
                <RadzenButton Text="Réinitialiser" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="@ResetSearch" />
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-ml-auto">
                    <RadzenCheckBox Value="@onlyWithoutDossier"
                                    TValue="bool"
                                    Change="@((bool value) => OnOnlyWithoutDossierChanged(value))"
                                    Disabled="@isLoadingDossierFilter" />
                    <RadzenLabel Text="Uniquement sans dossier" />
                </RadzenStack>
            </RadzenStack>

            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Cycle" Style="width:100%">
                        <RadzenDropDown Data="@cycleFilters"
                                        TextProperty="Libelle"
                                        ValueProperty="Id"
                                        TValue="long?"
                                        Value="@filterCycleId"
                                        Change="@(value => OnCycleFilterChanged(value))"
                                        AllowFiltering="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        AllowClear="true"
                                        Placeholder="Tous les cycles"
                                        Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Filière" Style="width:100%">
                        <RadzenDropDown Data="@filiereFilters"
                                        TextProperty="Libelle"
                                        ValueProperty="Id"
                                        TValue="long?"
                                        Value="@filterFiliereId"
                                        Change="@(value => OnFiliereFilterChanged(value))"
                                        AllowFiltering="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        AllowClear="true"
                                        Placeholder="Toutes les filières"
                                        Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Parcours académique" Style="width:100%">
                        <RadzenDropDown Data="@parcoursFilters"
                                        TextProperty="Libelle"
                                        ValueProperty="Id"
                                        TValue="long?"
                                        Value="@filterParcoursId"
                                        Change="@(value => OnParcoursFilterChanged(value))"
                                        AllowFiltering="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        AllowClear="true"
                                        Placeholder="Tous les parcours"
                                        Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" Gap="1.25rem" Wrap="FlexWrap.Wrap" class="riis-student-totals">
                <RadzenText Text="@($"Total étudiants : {totalEtudiants}")" />
                <RadzenText Text="@($"Résultats : {items.Count}")" />
                <RadzenText Text="@($"Avec dossier : {TotalAvecDossier}")" />
                <RadzenText Text="@($"Sans dossier : {TotalSansDossier}")" />
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>

    @if (showForm)
    {
        <div class="riis-modal-backdrop">
            <RadzenCard class="riis-modal">
            <RadzenTemplateForm TItem="EtudiantDto" Data="@model" Submit="@Save">
                <RadzenStack Gap="1rem">
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="riis-modal-title rz-m-0">@(model.Id == 0 ? "Nouvel étudiant" : "Modifier l'étudiant")</RadzenText>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="Nom" Style="width:100%">
                                <RadzenTextBox @bind-Value="@model.Nom" Name="Nom" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="Nom" Text="Nom obligatoire." />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="8">
                            <RadzenFormField Text="Prénoms" Style="width:100%">
                                <RadzenTextBox @bind-Value="@model.Prenoms" Name="Prenoms" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="Prenoms" Text="Prénoms obligatoires." />
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenFormField Text="Date de naissance" Style="width:100%">
                                <RadzenDatePicker TValue="DateTime?" Value="@DateNaissanceValue" Change="@OnDateNaissanceChanged" DateFormat="dd/MM/yyyy" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="Lieu de naissance" Style="width:100%">
                                <RadzenTextBox @bind-Value="@model.LieuNaissance" Name="LieuNaissance" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="LieuNaissance" Text="Lieu obligatoire." />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="2">
                            <RadzenFormField Text="Sexe" Style="width:100%">
                                <RadzenDropDown AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Data="@sexes" TextProperty="Text" ValueProperty="Value" @bind-Value="@model.Sexe" Name="Sexe" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenFormField Text="Aptitude médicale" Style="width:100%">
                                <RadzenDropDown AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Data="@aptitudes" TextProperty="Text" ValueProperty="Value" @bind-Value="@model.AptitudeMedicale" Name="AptitudeMedicale" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenFormField Text="Nationalité" Style="width:100%">
                                <RadzenTextBox @bind-Value="@model.Nationalite" Name="Nationalite" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="Nationalite" Text="Nationalité obligatoire." />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenFormField Text="Région d'origine" Style="width:100%">
                                <RadzenTextBox @bind-Value="@model.RegionOrigine" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenFormField Text="Téléphone personnel" Style="width:100%">
                                <RadzenTextBox @bind-Value="@model.TelephonePrincipal" Name="TelephonePrincipal" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenFormField Text="Téléphone secondaire" Style="width:100%">
                                <RadzenTextBox @bind-Value="@model.TelephoneSecondaire" Name="TelephoneSecondaire" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenFormField Text="Téléphone parent 1" Style="width:100%">
                                <RadzenTextBox @bind-Value="@model.TelephoneParent1" Name="TelephoneParent1" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenFormField Text="Téléphone parent 2" Style="width:100%">
                                <RadzenTextBox @bind-Value="@model.TelephoneParent2" Name="TelephoneParent2" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="Email" Style="width:100%">
                                <RadzenTextBox @bind-Value="@model.Email" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="Lieu de résidence" Style="width:100%">
                                <RadzenTextBox @bind-Value="@model.LieuResidence" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="Photo URL" Style="width:100%">
                                <RadzenTextBox @bind-Value="@model.PhotoUrl" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Nom du père" Style="width:100%">
                                <RadzenTextBox @bind-Value="@model.NomPere" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Nom de la mère" Style="width:100%">
                                <RadzenTextBox @bind-Value="@model.NomMere" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                        <RadzenButton Text="Annuler" Icon="close" ButtonStyle="ButtonStyle.Light" Click="@Cancel" />
                        <RadzenButton Text="Enregistrer" Icon="save" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenTemplateForm>
            </RadzenCard>
        </div>
    }

    <RadzenCard>
<RadzenDataGrid @ref="etudiantsGrid" Data="@items" TItem="EtudiantDto" AllowPaging="true" AllowSorting="true" AllowColumnResize="true" AllowFiltering="true" PageSize="10">
            <Columns>
                <RadzenDataGridColumn TItem="EtudiantDto" Property="Nom" Title="Nom" />
                <RadzenDataGridColumn TItem="EtudiantDto" Property="Prenoms" Title="Prénoms" />
                <RadzenDataGridColumn TItem="EtudiantDto" Property="Sexe" Title="Sexe" Width="120px" />
                <RadzenDataGridColumn TItem="EtudiantDto" Title="Naissance" Width="140px">
                    <Template Context="item">@item.DateNaissance.ToString("dd/MM/yyyy")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="EtudiantDto" Property="TelephonePrincipal" Title="Téléphone" Width="160px" />
                <RadzenDataGridColumn TItem="EtudiantDto" Title="Parcours académique" Width="320px" Sortable="false" Filterable="false">
                    <Template Context="item">
                        <RadzenDropDown Data="@parcoursAcademiques"
                                        @key="item.Id"
                                        TextProperty="Libelle"
                                        ValueProperty="Id"
                                        TValue="long?"
                                        @bind-Value="selectedParcoursByEtudiant[item.Id]"
                                        AllowFiltering="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        AllowClear="true"
                                        Placeholder="Sélectionner un parcours"
                                        Style="width:100%" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="EtudiantDto" Title="Actions" Width="330px" Sortable="false" Filterable="false">
                    <Template Context="item">
                        <RadzenButton Text="@GetDossierActionText(item)"
                                      Icon="@GetDossierActionIcon(item)"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="@(HasCurrentDossier(item.Id) ? ButtonStyle.Primary : ButtonStyle.Success)"
                                      Variant="Variant.Flat"
                                      Disabled="@IsDossierActionDisabled(item.Id)"
                                      Click="@(() => ManageDossier(item))"
                                      title="@GetDossierActionTitle(item)" />
                        <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => Edit(item))" />
                        @if (isAdmin)
                        {
                            <RadzenButton Icon="delete"
                                          Size="ButtonSize.Small"
                                          ButtonStyle="ButtonStyle.Danger"
                                          Variant="Variant.Flat"
                                          Disabled="@HasDossier(item.Id)"
                                          Click="@(() => Delete(item))"
                                          title="@(HasDossier(item.Id) ? "Suppression impossible : un dossier étudiant existe" : "Supprimer l'étudiant")"
                                          class="rz-ml-1" />
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</RadzenStack>

@code {
    private List<EtudiantDto> items = [];
    private List<EtudiantDto> allItems = [];
    private List<ParcoursAcademiqueDto> parcoursAcademiques = [];
    private RadzenDataGrid<EtudiantDto>? etudiantsGrid;
    private EtudiantDto model = new();
    private string? searchText;
    private bool showForm;
    private bool onlyWithoutDossier;
    private bool isLoadingDossierFilter;
    private bool dossierStudentsLoaded;
    private bool isAdmin;
    private long? filterCycleId;
    private long? filterFiliereId;
    private long? filterParcoursId;
    private HashSet<long> studentsWithDossier = [];
    private readonly Dictionary<long, long> currentDossierParcoursByEtudiant = [];
    private readonly Dictionary<long, long?> selectedParcoursByEtudiant = [];
    private readonly HashSet<long> creatingDossierForEtudiants = [];

    private IReadOnlyList<CycleFormationDto> cycleFilters
        => parcoursAcademiques
            .GroupBy(x => new { x.CycleFormationId, x.CycleCode, x.CycleLibelle })
            .Select(x => new CycleFormationDto
            {
                Id = x.Key.CycleFormationId,
                Code = x.Key.CycleCode,
                Libelle = x.Key.CycleLibelle
            })
            .OrderBy(x => x.Libelle, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private IReadOnlyList<FiliereDto> filiereFilters
        => parcoursAcademiques
            .Where(x => !filterCycleId.HasValue || x.CycleFormationId == filterCycleId.Value)
            .GroupBy(x => new { x.FiliereId, x.FiliereCode, x.FiliereLibelle })
            .Select(x => new FiliereDto
            {
                Id = x.Key.FiliereId,
                Code = x.Key.FiliereCode,
                Libelle = x.Key.FiliereLibelle
            })
            .OrderBy(x => x.Libelle, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private IReadOnlyList<ParcoursAcademiqueDto> parcoursFilters
        => parcoursAcademiques
            .Where(x => !filterCycleId.HasValue || x.CycleFormationId == filterCycleId.Value)
            .Where(x => !filterFiliereId.HasValue || x.FiliereId == filterFiliereId.Value)
            .OrderBy(x => x.Libelle, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private int totalEtudiants => allItems.Count;

    private int TotalAvecDossier => items.Count(x => HasDossier(x.Id));

    private int TotalSansDossier => items.Count(x => !HasDossier(x.Id));

    private DateTime? DateNaissanceValue => model.DateNaissance.ToDateTime(TimeOnly.MinValue);

    private readonly List<EnumOption<Sexe>> sexes =
    [
        new("Non renseigné", Sexe.NonRenseigne),
        new("Masculin", Sexe.Masculin),
        new("Féminin", Sexe.Feminin)
    ];

    private readonly List<EnumOption<AptitudeMedicale>> aptitudes =
    [
        new("Non renseignée", AptitudeMedicale.NonRenseignee),
        new("Apte", AptitudeMedicale.Apte),
        new("Inapte", AptitudeMedicale.Inapte)
    ];

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAdmin = authenticationState.User.IsInRole("Admin");
        parcoursAcademiques = await ReferentielsService.GetParcoursAcademiquesAsync(inclureInactifs: false);
        await EnsureDossierStateLoaded();
        await Load();
    }

    private async Task Load()
    {
        allItems = await EtudiantsService.GetEtudiantsAsync(searchText);
        foreach (var item in allItems)
        {
            selectedParcoursByEtudiant.TryAdd(item.Id, null);
        }

        ApplyFilters();

        if (etudiantsGrid is not null) await etudiantsGrid.Reload();
    }

    private async Task Search() => await Load();

    private async Task ResetSearch()
    {
        searchText = null;
        filterCycleId = null;
        filterFiliereId = null;
        filterParcoursId = null;
        onlyWithoutDossier = false;
        await Load();
    }

    private async Task OnCycleFilterChanged(object? value)
    {
        filterCycleId = ToNullableLong(value);

        if (filterFiliereId.HasValue
            && !filiereFilters.Any(x => x.Id == filterFiliereId.Value))
        {
            filterFiliereId = null;
        }

        if (filterParcoursId.HasValue
            && !parcoursFilters.Any(x => x.Id == filterParcoursId.Value))
        {
            filterParcoursId = null;
        }

        ApplyFilters();
        await ReloadGrid();
    }

    private async Task OnFiliereFilterChanged(object? value)
    {
        filterFiliereId = ToNullableLong(value);

        if (filterParcoursId.HasValue
            && !parcoursFilters.Any(x => x.Id == filterParcoursId.Value))
        {
            filterParcoursId = null;
        }

        ApplyFilters();
        await ReloadGrid();
    }

    private async Task OnParcoursFilterChanged(object? value)
    {
        filterParcoursId = ToNullableLong(value);
        ApplyFilters();
        await ReloadGrid();
    }

    private async Task OnOnlyWithoutDossierChanged(bool value)
    {
        onlyWithoutDossier = value;

        if (value)
        {
            isLoadingDossierFilter = true;
            try
            {
                await EnsureDossierStateLoaded();
            }
            finally
            {
                isLoadingDossierFilter = false;
            }
        }

        await Load();
    }

    private void ApplyFilters()
    {
        items = allItems
            .Where(x => !onlyWithoutDossier || !studentsWithDossier.Contains(x.Id))
            .Where(MatchesAcademicFilters)
            .ToList();
    }

    private bool MatchesAcademicFilters(EtudiantDto item)
    {
        if (!filterCycleId.HasValue && !filterFiliereId.HasValue && !filterParcoursId.HasValue)
        {
            return true;
        }

        if (!currentDossierParcoursByEtudiant.TryGetValue(item.Id, out var parcoursId))
        {
            return false;
        }

        var parcours = parcoursAcademiques.FirstOrDefault(x => x.Id == parcoursId);
        return parcours is not null
            && (!filterCycleId.HasValue || parcours.CycleFormationId == filterCycleId.Value)
            && (!filterFiliereId.HasValue || parcours.FiliereId == filterFiliereId.Value)
            && (!filterParcoursId.HasValue || parcours.Id == filterParcoursId.Value);
    }

    private async Task ReloadGrid()
    {
        if (etudiantsGrid is not null)
        {
            await etudiantsGrid.Reload();
        }
    }

    private static long? ToNullableLong(object? value)
        => value switch
        {
            long id => id,
            int id => id,
            null => null,
            _ when long.TryParse(value.ToString(), out var id) => id,
            _ => null
        };

    private async Task EnsureDossierStateLoaded()
    {
        if (dossierStudentsLoaded)
        {
            return;
        }

        var dossiers = await DossierEtudiantService.GetDossiersEtudiantAnnuelsAsync();
        studentsWithDossier = dossiers
            .Select(x => x.EtudiantId)
            .ToHashSet();
        foreach (var dossier in dossiers)
        {
            currentDossierParcoursByEtudiant.TryAdd(dossier.EtudiantId, dossier.ParcoursAcademiqueId);
            selectedParcoursByEtudiant.TryAdd(dossier.EtudiantId, dossier.ParcoursAcademiqueId);
        }

        dossierStudentsLoaded = true;
    }

    private void Create()
    {
        model = EtudiantsService.CreateDefaultEtudiant();
        showForm = true;
    }

    private void Edit(EtudiantDto item)
    {
        model = new EtudiantDto
        {
            Id = item.Id,
            Nom = item.Nom,
            Prenoms = item.Prenoms,
            DateNaissance = item.DateNaissance,
            LieuNaissance = item.LieuNaissance,
            Sexe = item.Sexe,
            AptitudeMedicale = item.AptitudeMedicale,
            Nationalite = item.Nationalite,
            RegionOrigine = item.RegionOrigine,
            TelephonePrincipal = item.TelephonePrincipal,
            TelephoneSecondaire = item.TelephoneSecondaire,
            TelephoneParent1 = item.TelephoneParent1,
            TelephoneParent2 = item.TelephoneParent2,
            Email = item.Email,
            NomPere = item.NomPere,
            NomMere = item.NomMere,
            LieuResidence = item.LieuResidence,
            PhotoUrl = item.PhotoUrl
        };
        showForm = true;
    }

    private async Task Save(EtudiantDto _)
    {
        try
        {
            await EtudiantsService.SaveEtudiantAsync(model);
            NotifySuccess();
            showForm = false;
            await Load();
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
    }

    private async Task Delete(EtudiantDto item)
    {
        if (!isAdmin)
        {
            NotifyError("Seul un administrateur peut supprimer un étudiant.");
            return;
        }

        if (HasDossier(item.Id))
        {
            NotifyError("Cet étudiant possède déjà un dossier et ne peut pas être supprimé.");
            return;
        }

        try
        {
            await EtudiantsService.DeleteEtudiantAsync(item.Id);
            studentsWithDossier.Remove(item.Id);
            await Load();
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
    }

    private bool HasDossier(long etudiantId)
        => studentsWithDossier.Contains(etudiantId);

    private long? GetSelectedParcoursId(long etudiantId)
        => selectedParcoursByEtudiant.TryGetValue(etudiantId, out var parcoursId)
            ? parcoursId
            : null;

    private string GetDossierActionText(EtudiantDto item)
        => HasCurrentDossier(item.Id)
            ? "Modifier le dossier"
            : "Créer dossier";

    private string GetDossierActionIcon(EtudiantDto item)
        => HasCurrentDossier(item.Id)
                ? "edit_note"
                : "create_new_folder";

    private string GetDossierActionTitle(EtudiantDto item)
        => HasCurrentDossier(item.Id)
            ? "Modifier le dossier pour le parcours sélectionné"
            : "Créer le dossier pour le parcours sélectionné";

    private bool HasCurrentDossier(long etudiantId)
        => currentDossierParcoursByEtudiant.ContainsKey(etudiantId);

    private bool IsDossierActionDisabled(long etudiantId)
        => IsCreatingDossier(etudiantId)
            || GetSelectedParcoursId(etudiantId) is null
            || (currentDossierParcoursByEtudiant.TryGetValue(etudiantId, out var currentParcoursId)
                && currentParcoursId == GetSelectedParcoursId(etudiantId));

    private async Task ManageDossier(EtudiantDto item)
    {
        var parcoursId = GetSelectedParcoursId(item.Id);
        if (parcoursId is null || !creatingDossierForEtudiants.Add(item.Id))
        {
            return;
        }

        try
        {
            if (HasCurrentDossier(item.Id))
            {
                var ancienParcoursId = currentDossierParcoursByEtudiant[item.Id];
                await DossierEtudiantService.ChangeParcoursAcademiqueAsync(
                    item.Id,
                    ancienParcoursId,
                    parcoursId.Value);

                currentDossierParcoursByEtudiant[item.Id] = parcoursId.Value;
                NotifySuccess("Parcours modifié et dossier financier recalculé avec les tarifs du nouveau parcours.");
                await Load();
                return;
            }

            await DossierEtudiantService.GetOrCreateDossierEtudiantAnnuelAsync(item.Id, parcoursId.Value);
            studentsWithDossier.Add(item.Id);
            currentDossierParcoursByEtudiant[item.Id] = parcoursId.Value;
            dossierStudentsLoaded = true;
            NotifySuccess("Dossier étudiant créé.");

            Navigation.NavigateTo($"/etudiants/{item.Id}/dossier?parcoursAcademiqueId={parcoursId.Value}");
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
        finally
        {
            creatingDossierForEtudiants.Remove(item.Id);
        }
    }

    private bool IsCreatingDossier(long etudiantId)
        => creatingDossierForEtudiants.Contains(etudiantId);

    private void OnDateNaissanceChanged(DateTime? value)
    {
        if (value is not null)
        {
            model.DateNaissance = DateOnly.FromDateTime(value.Value);
        }
    }

    private void Cancel() => showForm = false;
    private void NotifySuccess(string message = "Données enregistrées.")
        => NotificationService.Notify(NotificationSeverity.Success, "Succès", message);
    private void NotifyError(string message) => NotificationService.Notify(NotificationSeverity.Error, "Erreur", message);

    private record EnumOption<TValue>(string Text, TValue Value);
}
