    private async Task RefreshSemestresAsync()
    {
        if (selectedAnneeAcademiqueId is null || selectedClassePedagogiqueId is null)
        {
            semestresPedagogiques = [];
            return;
        }

        semestresPedagogiques = await SaisieNotesService.GetSemestresForClasseLookupAsync(
            selectedAnneeAcademiqueId.Value,
            selectedClassePedagogiqueId.Value);
        EnsureSelectedValueIsAvailable(semestresPedagogiques, ref selectedSemestrePedagogiqueId);
    }

    private async Task RefreshElementsConstitutifsAsync()
    {
        if (selectedSemestrePedagogiqueId is null || selectedUniteEnseignementId is null)
        {
            elementsConstitutifs = [];
            selectedElementConstitutifId = null;
            return;
        }

        elementsConstitutifs = await SaisieNotesService.GetElementsConstitutifsLookupAsync(
            selectedUniteEnseignementId,
            selectedSemestrePedagogiqueId);
        EnsureSelectedValueIsAvailable(elementsConstitutifs, ref selectedElementConstitutifId);
