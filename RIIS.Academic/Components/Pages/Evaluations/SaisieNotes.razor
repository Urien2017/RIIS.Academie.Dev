    private void ExportCanevas()
    {
        if (!CanExportCanevas)
        {
            return;
        }

        var query = new List<string>
        {
            $"semestrePedagogiqueId={selectedSemestrePedagogiqueId!.Value}"
        };
        if (selectedUniteEnseignementId is not null)
        {
            query.Add($"uniteEnseignementId={selectedUniteEnseignementId.Value}");
        }

        if (selectedElementConstitutifId is not null)
        {
            query.Add($"elementConstitutifId={selectedElementConstitutifId.Value}");
        }

        if (selectedTypeEvaluation is not null)
        {
            query.Add($"typeEvaluation={(int)selectedTypeEvaluation.Value}");
        }

        var suffix = query.Count == 0 ? string.Empty : $"?{string.Join("&", query)}";
        Navigation.NavigateTo(
            $"/exports/notes/canevas/{selectedAnneeAcademiqueId!.Value}/{selectedClassePedagogiqueId!.Value}.xlsx{suffix}",
            forceLoad: true);
    }

