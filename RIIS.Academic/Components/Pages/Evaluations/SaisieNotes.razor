    private async Task ImportCanevas(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file is null)
        {
            return;
        }

        selectedFileName = file.Name;

        try
        {
            await using var stream = file.OpenReadStream(20 * 1024 * 1024);
            importResult = await NotesCanevasExcelImportService.ImporterAsync(stream);

            if (importResult.IsValid)
            {
                NotificationService.Notify(
                    NotificationSeverity.Success,
                    "Import terminé",
                    $"{importResult.NotesTraitees} note(s) traitée(s). ");

                if (CanLoadGrille)
                {
                    await LoadGrille();
                }
            }
            else
            {
                NotifyError(string.Join(" | ", importResult.Errors));
            }
        }
        catch (Exception ex)
        {
            importResult = new NotesCanevasImportResultDto();
            importResult.Errors.Add(ex.Message);
            NotifyError(ex.Message);
        }
    }

    private async Task AnalyseNotesDocument(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file is null)
        {
            return;
        }

        selectedNotesDocumentFileName = file.Name;
        notesDocumentPreview = null;
        notesDocumentImportResult = null;

        try
        {
            await using var stream = file.OpenReadStream(25 * 1024 * 1024);
            notesDocumentPreview = await NotesDocumentImportService.AnalyserAsync(
                stream,
                file.Name);

            selectedTypeEvaluation = notesDocumentPreview.TypeEvaluationExtrait
                ?? selectedTypeEvaluation
                ?? TypeEvaluation.SessionNormale;
            await ApplyExtractedDocumentContextAsync();
            await EnsureEvaluationForDocumentAsync();

            if (notesDocumentPreview.IsValid)
            {
                NotificationService.Notify(
                    NotificationSeverity.Info,
                    "Aperçu prêt",
                    $"{notesDocumentPreview.Lignes.Count} ligne(s) de notes ont été extraite(s). Vérifiez-les avant l'import.");
            }
            else
            {
                NotifyError(string.Join(" | ", notesDocumentPreview.Errors));
            }
        }
        catch (Exception ex)
        {
            notesDocumentPreview = new NotesDocumentPreviewDto
            {
                FileName = file.Name,
                Errors = [ex.Message]
            };
            NotifyError(ex.Message);
        }
    }

    private async Task ImporterNotesDocument()
    {
        // Rejoue la résolution juste avant l'écriture : cela couvre le cas où
        // le composant a été rendu pendant le chargement des listes ou si
        // l'utilisateur a corrigé une sélection après l'analyse du document.
        await ApplyExtractedDocumentContextAsync();
        await EnsureEvaluationForDocumentAsync();

        if (showMissingEvaluationForm)
        {
            return;
        }

        if (!CanImportNotesDocument || notesDocumentPreview is null)
        {
            NotifyError(NotesDocumentImportState);
            return;
        }

        if (!HasResolvedNotesDocumentContext)
        {
            NotifyError(GetUnresolvedNotesDocumentContext());
            return;
        }

        notesDocumentImporting = true;
        try
        {
            notesDocumentImportResult = await NotesDocumentImportService.ImporterAsync(
                notesDocumentPreview,
                new NotesDocumentImportContextDto
                {
                    AnneeAcademiqueId = selectedAnneeAcademiqueId!.Value,
                    ClassePedagogiqueId = selectedClassePedagogiqueId!.Value,
                    SemestrePedagogiqueId = selectedSemestrePedagogiqueId!.Value,
                    UniteEnseignementId = selectedUniteEnseignementId,
                    ElementConstitutifId = selectedElementConstitutifId,
                    EvaluationAcademiqueId = selectedEvaluationAcademiqueId,
                    TypeEvaluation = selectedTypeEvaluation
                });

            if (notesDocumentImportResult.IsValid)
            {
                selectedEvaluationAcademiqueId = notesDocumentImportResult.EvaluationAcademiqueId;
                NotificationService.Notify(
                    NotificationSeverity.Success,
                    "Import terminé",
                    $"{notesDocumentImportResult.NotesTraitees} note(s) enregistrée(s).");
                await LoadGrille();
            }
            else
            {
                NotifyError(string.Join(" | ", notesDocumentImportResult.Errors));
            }
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
        finally
        {
            notesDocumentImporting = false;
        }
    }

    private async Task EnsureEvaluationForDocumentAsync()
    {
        if (notesDocumentPreview?.IsValid != true
            || selectedAnneeAcademiqueId is not long anneeId
            || selectedClassePedagogiqueId is not long classeId
            || selectedSemestrePedagogiqueId is not long semestreId
            || selectedElementConstitutifId is not long elementId
            || selectedTypeEvaluation is not TypeEvaluation typeEvaluation
            || selectedEvaluationAcademiqueId is not null)
        {
            return;
        }

        await RefreshEvaluationsAsync();
        if (selectedEvaluationAcademiqueId is not null || evaluations.Count > 0)
        {
            return;
        }

        var context = await SaisieNotesService.GetEvaluationContextAsync(
            anneeId,
            classeId,
            semestreId,
            elementId);
        if (context is null)
        {
            return;
        }

        missingEvaluationModel = await EvaluationsService.CreateDefaultEvaluationAsync(
            context.ParcoursAcademiqueId,
            context.MaquetteElementConstitutifId,
            typeEvaluation);

        missingEvaluationModel.AnneeAcademiqueId = anneeId;
        missingEvaluationModel.ParcoursAcademiqueId = context.ParcoursAcademiqueId;
        missingEvaluationModel.MaquetteElementConstitutifId = context.MaquetteElementConstitutifId;
        missingEvaluationModel.SemestrePedagogiqueId = semestreId;
        missingEvaluationModel.SemestrePedagogiqueLibelle = semestresPedagogiques
            .FirstOrDefault(x => x.Id == semestreId)?.Libelle ?? string.Empty;
        missingEvaluationModel.UniteEnseignementId = selectedUniteEnseignementId ?? 0;
        missingEvaluationModel.UniteEnseignementLibelle = unitesEnseignement
            .FirstOrDefault(x => x.Id == selectedUniteEnseignementId)?.Libelle ?? string.Empty;
        missingEvaluationModel.ElementConstitutifLibelle = elementsConstitutifs
            .FirstOrDefault(x => x.Id == elementId)?.Libelle
            ?? notesDocumentPreview.ElementConstitutifExtrait
            ?? string.Empty;
        missingEvaluationModel.Type = typeEvaluation;
        missingEvaluationModel.TypeLibelle = GetTypeEvaluationLibelle(typeEvaluation);
        showMissingEvaluationForm = true;
    }

    private async Task SaveMissingEvaluation(EvaluationAcademiqueDto _)
    {
        savingMissingEvaluation = true;
        try
        {
            await EvaluationsService.SaveEvaluationAsync(missingEvaluationModel);

            showMissingEvaluationForm = false;
            selectedTypeEvaluation = missingEvaluationModel.Type;
            selectedEvaluationAcademiqueId = null;
            await RefreshEvaluationsAsync();

            NotificationService.Notify(
                NotificationSeverity.Success,
                "Évaluation enregistrée",
                "L'évaluation a été créée. Vous pouvez maintenant enregistrer les notes de la fiche.");
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
        finally
        {
            savingMissingEvaluation = false;
        }
    }

    private void CancelMissingEvaluation()
    {
        showMissingEvaluationForm = false;
    }

    private void ClearNotesDocumentPreview()
    {
        notesDocumentPreview = null;
        notesDocumentImportResult = null;
        selectedNotesDocumentFileName = "Aucun document sélectionné";
    }

    private async Task ApplyExtractedDocumentContextAsync()
    {
        if (notesDocumentPreview is null)
        {
            return;
        }

        // Les identifiants d'une précédente fiche ne doivent jamais être
        // réutilisés si le nouveau document contient un autre contexte.
        var classeSelectionneeAvantImport = selectedClassePedagogiqueId;
        if (!string.IsNullOrWhiteSpace(notesDocumentPreview.ClasseLibelleExtrait))
        {
            selectedClassePedagogiqueId = null;
            selectedSemestrePedagogiqueId = null;
            semestresPedagogiques = [];
        }

        selectedUniteEnseignementId = null;
        selectedElementConstitutifId = null;

        if (!string.IsNullOrWhiteSpace(notesDocumentPreview.AnneeAcademiqueLibelleExtrait))
        {
            var annee = anneesAcademiques.FirstOrDefault(x =>
                string.Equals(
                    NormalizeLookupText(x.Libelle),
                    NormalizeLookupText(notesDocumentPreview.AnneeAcademiqueLibelleExtrait),
                    StringComparison.OrdinalIgnoreCase));
            if (annee is null)
            {
                selectedAnneeAcademiqueId = null;
                selectedClassePedagogiqueId = null;
                selectedSemestrePedagogiqueId = null;
                classesPedagogiques = [];
                semestresPedagogiques = [];
            }
            else if (selectedAnneeAcademiqueId != annee.Id)
            {
                selectedAnneeAcademiqueId = annee.Id;
                selectedClassePedagogiqueId = null;
                selectedSemestrePedagogiqueId = null;
                await RefreshClassesAsync();
            }
        }

        if (!string.IsNullOrWhiteSpace(notesDocumentPreview.ClasseLibelleExtrait))
        {
            // Toujours relire la liste de l'année : le composant peut avoir été
            // rendu avant la fin du chargement ou conserver une liste d'une
            // ancienne année sélectionnée.
            List<LookupDto> classesDeLAnnee = selectedAnneeAcademiqueId is long anneeId
                ? await SaisieNotesService.GetClassesPedagogiquesLookupAsync(anneeId)
                : [];
            var classe = FindLookupContaining(
                classesDeLAnnee,
                notesDocumentPreview.ClasseLibelleExtrait);

            // Certains dossiers historiques ne portent pas le même libellé de
            // classe que le parcours affiché dans l'interface. On réessaie sur
            // la liste complète, puis on déduit l'année depuis le libellé
            // complet de la classe si cela est possible.
            if (classe is null)
            {
                var toutesLesClasses = await SaisieNotesService.GetClassesPedagogiquesLookupAsync();
                classe = FindLookupContaining(toutesLesClasses, notesDocumentPreview.ClasseLibelleExtrait);

                if (classe is not null)
                {
                    var anneeDeLaClasse = anneesAcademiques.FirstOrDefault(x =>
                        NormalizeLookupText(classe.Libelle)
                            .Contains(NormalizeLookupText(x.Libelle), StringComparison.OrdinalIgnoreCase));

                    if (anneeDeLaClasse is not null
                        && selectedAnneeAcademiqueId != anneeDeLaClasse.Id)
                    {
                        selectedAnneeAcademiqueId = anneeDeLaClasse.Id;
                        classesDeLAnnee = await SaisieNotesService
                            .GetClassesPedagogiquesLookupAsync(anneeDeLaClasse.Id);
                        classe = classesDeLAnnee.FirstOrDefault(x => x.Id == classe.Id);
                    }
                }
            }

            // Secours pour les fiches historiques dont la classe est un nom
            // local (« Classe Kribi »). Les matricules restent liés au vrai
            // parcours académique : si toutes les lignes appartiennent à une
            // seule classe, cette relation permet de retrouver son identifiant.
            if (classe is null && selectedAnneeAcademiqueId is long anneePourMatricules)
            {
                var classesDesMatricules = await SaisieNotesService
                    .GetClassesForMatriculesLookupAsync(
                        notesDocumentPreview.Lignes.Select(x => x.Matricule),
                        anneePourMatricules);
                if (classesDesMatricules.Count == 1)
                {
                    classe = classesDesMatricules[0];
                    classesDeLAnnee = classesDeLAnnee.Count > 0
                        ? classesDeLAnnee
                        : await SaisieNotesService.GetClassesPedagogiquesLookupAsync(anneePourMatricules);
                }
            }

            // Les anciennes fiches utilisent parfois un nom local comme
            // « Classe Kribi ». Depuis la normalisation du modèle, la liste UI
            // affiche le libellé du parcours et non ce nom local. Si l'utilisateur
            // avait déjà choisi explicitement une classe, on la conserve plutôt
            // que d'abandonner la résolution sur ce simple alias historique.
            if (classe is null && classeSelectionneeAvantImport is long classeId)
            {
                classe = classesDeLAnnee.FirstOrDefault(x => x.Id == classeId)
                    ?? classesPedagogiques.FirstOrDefault(x => x.Id == classeId);
            }

            if (classe is not null)
            {
                classesPedagogiques = classesDeLAnnee.Count > 0
                    ? classesDeLAnnee
                    : [classe];
                selectedClassePedagogiqueId = classe.Id;
                selectedSemestrePedagogiqueId = null;
                await RefreshSemestresAsync();
            }
        }

        if (notesDocumentPreview.NumeroSemestreExtrait is byte numeroSemestre)
        {
            var semestre = FindSemesterLookup(semestresPedagogiques, numeroSemestre);
            if (semestre is not null)
            {
                selectedSemestrePedagogiqueId = semestre.Id;
            }
        }

        await RefreshUnitesEnseignementAsync();

        var allElements = selectedSemestrePedagogiqueId is long semestreId
            ? await SaisieNotesService.GetElementsConstitutifsLookupAsync(
                semestrePedagogiqueId: semestreId)
            : [];
        var elementCode = ExtractMetadataCode(notesDocumentPreview.ElementConstitutifExtrait);
        var element = string.IsNullOrWhiteSpace(elementCode)
            ? null
            : allElements.FirstOrDefault(x => HasLookupCode(x.Libelle, elementCode));

        var ueCode = ExtractMetadataCode(notesDocumentPreview.UniteEnseignementExtrait);
        var unite = string.IsNullOrWhiteSpace(ueCode)
            ? null
            : unitesEnseignement.FirstOrDefault(x => HasLookupCode(x.Libelle, ueCode));

        selectedUniteEnseignementId = unite?.Id;
        elementsConstitutifs = unite is null
            ? allElements
            : await SaisieNotesService.GetElementsConstitutifsLookupAsync(
                unite.Id,
                selectedSemestrePedagogiqueId);

        // L'EC trouvé par son code est l'identifiant métier le plus fiable.
        // On le conserve même si le libellé UE de la fiche est légèrement
        // différent ; l'importeur vérifiera ensuite que l'EC appartient bien
        // au semestre sélectionné.
        if (element is not null)
        {
            selectedElementConstitutifId = element.Id;
        }

        await RefreshEvaluationsAsync();
    }

    private string GetUnresolvedNotesDocumentContext()
    {
        if (notesDocumentPreview is null)
        {
            return NotesDocumentImportState;
        }

        var missing = new List<string>();
        if (selectedAnneeAcademiqueId is null)
        {
            missing.Add($"année '{notesDocumentPreview.AnneeAcademiqueLibelleExtrait ?? "non détectée"}'");
        }

        if (selectedClassePedagogiqueId is null)
        {
            missing.Add($"classe '{notesDocumentPreview.ClasseLibelleExtrait ?? "non détectée"}'");
        }

        if (selectedSemestrePedagogiqueId is null)
        {
            var semestre = notesDocumentPreview.NumeroSemestreExtrait?.ToString(CultureInfo.InvariantCulture)
                ?? notesDocumentPreview.SemestreLibelleExtrait
                ?? "non détecté";
            missing.Add($"semestre '{semestre}'");
        }

        if (selectedElementConstitutifId is null)
        {
            missing.Add($"EC '{notesDocumentPreview.ElementConstitutifExtrait ?? "non détecté"}'");
        }

        if (selectedEvaluationAcademiqueId is null && selectedTypeEvaluation is null)
        {
            missing.Add("type d'évaluation");
        }

        return missing.Count == 0
            ? "Le contexte de la fiche est résolu, mais son import ne peut pas démarrer."
            : $"Référentiel introuvable pour : {string.Join(", ", missing)}.";
    }

    private static LookupDto? FindLookupContaining(
        IReadOnlyCollection<LookupDto> options,
        string value)
    {
        var target = NormalizeLookupText(value);
        var directMatch = options
            .Select(x =>
            {
                var candidate = NormalizeLookupText(x.Libelle);
                var exact = string.Equals(candidate, target, StringComparison.OrdinalIgnoreCase);
                var candidateContainsTarget = candidate.Contains(target, StringComparison.OrdinalIgnoreCase);
                var targetContainsCandidate = target.Contains(candidate, StringComparison.OrdinalIgnoreCase);
                var rank = exact
                    ? 0
                    : candidateContainsTarget
                        ? 1
                        : targetContainsCandidate
                            ? 2
                            : 3;
                var distance = Math.Abs(candidate.Length - target.Length);
                return new { Option = x, Candidate = candidate, Rank = rank, Distance = distance };
            })
            .Where(x => x.Rank < 3)
            .OrderBy(x => x.Rank)
            .ThenBy(x => x.Distance)
            .ThenBy(x => x.Option.Libelle.Length)
            .Select(x => x.Option)
            .FirstOrDefault();

        if (directMatch is not null)
        {
            return directMatch;
        }

        // Les libellés de parcours/classes peuvent contenir l'année et des
        // variantes éditoriales (par exemple « Ingénieur - Informatique »).
        // Dans ce cas, les mots du libellé extrait restent plus fiables que
        // la comparaison d'une chaîne continue.
        var targetTokens = GetLookupTokens(value);
        if (targetTokens.Count == 0)
        {
            return null;
        }

        return options
            .Select(option =>
            {
                var candidateTokens = GetLookupTokens(option.Libelle);
                var overlap = targetTokens.Count(token => candidateTokens.Contains(token));
                var missing = candidateTokens.Count(token => !targetTokens.Contains(token));
                return new { Option = option, Overlap = overlap, Missing = missing };
            })
            .Where(x => x.Overlap >= Math.Min(3, targetTokens.Count))
            .OrderByDescending(x => x.Overlap)
            .ThenBy(x => x.Missing)
            .ThenByDescending(x => x.Option.Libelle.Length)
            .Select(x => x.Option)
            .FirstOrDefault();
    }

    private static HashSet<string> GetLookupTokens(string value)
    {
        var decomposed = value.Normalize(NormalizationForm.FormD);
        var separated = new string(
            decomposed
                .Select(character => char.IsLetterOrDigit(character) ? character : ' ')
                .ToArray());

        return separated
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(token => token.ToUpperInvariant())
            .Where(token => token.Length > 1)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    private static LookupDto? FindSemesterLookup(
        IReadOnlyCollection<LookupDto> options,
        byte numeroSemestre)
    {
        var number = numeroSemestre.ToString(CultureInfo.InvariantCulture);
        return options.FirstOrDefault(x =>
            x.Libelle.TrimStart().StartsWith($"{number} -", StringComparison.OrdinalIgnoreCase)
            || NormalizeLookupText(x.Libelle).Contains($"SEMESTRE{number}", StringComparison.OrdinalIgnoreCase));
    }

    private static string NormalizeLookupText(string? value)
    {
        var normalized = (value ?? string.Empty).Normalize(NormalizationForm.FormD);
        return string.Concat(normalized.Where(char.IsLetterOrDigit)).ToUpperInvariant();
    }

    private static string? ExtractMetadataCode(string? value)
        => string.IsNullOrWhiteSpace(value)
            ? null
            : value.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries)[0];

    private static bool HasLookupCode(string? label, string code)
        => string.Equals(ExtractMetadataCode(label), code, StringComparison.OrdinalIgnoreCase);

    private static bool HasExtractedElementMetadata(string? value)
    {
        var code = ExtractMetadataCode(value);
        return !string.IsNullOrWhiteSpace(code)
            && (code.Contains("-EC", StringComparison.OrdinalIgnoreCase)
                || code.StartsWith("EC", StringComparison.OrdinalIgnoreCase));
    }

    private void OnPresenceChanged(SaisieNoteLigneDto ligne)
    {
        if (ligne.StatutPresence != StatutPresenceEvaluation.Present)
        {
            ligne.Valeur = null;
        }
    }

    private static void AdjustDocumentNote(NotesDocumentRowDto ligne, decimal delta)
        => ligne.Valeur = ClampNote((ligne.Valeur ?? 0m) + delta, 20m);

    private static void AdjustSaisieNote(SaisieNoteLigneDto ligne, decimal delta)
        => ligne.Valeur = ClampNote((ligne.Valeur ?? 0m) + delta, 20m);

    private static decimal ClampNote(decimal value, decimal maximum)
        => Math.Clamp(Math.Round(value, 2, MidpointRounding.AwayFromZero), 0m, maximum);

    private async Task SaveNotes()
    {
        if (grille is null)
        {
            return;
        }

        try
        {
            await SaisieNotesService.SaveNotesAsync(grille);
            NotifySuccess();
            await LoadGrille();
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
    }

    private void NotifySuccess(string message = "Notes enregistrées.")
        => NotificationService.Notify(NotificationSeverity.Success, "Succès", message);

    private void NotifyError(string message) => NotificationService.Notify(NotificationSeverity.Error, "Erreur", message);

    private static string GetTypeEvaluationLibelle(TypeEvaluation type)
        => type switch
        {
            TypeEvaluation.ControleContinu => "CCON - Contrôle continu",
            TypeEvaluation.ControleConnaissance => "CC - Contrôle de connaissance",
            TypeEvaluation.SessionNormale => "SN - Session normale",
            TypeEvaluation.SessionRattrapage => "SR - Session de rattrapage",
            _ => type.ToString()
        };

    private static void EnsureSelectedValueIsAvailable(IReadOnlyCollection<LookupDto> options, ref long? selectedValue)
    {
        var value = selectedValue;

        if (value is not null && options.All(x => x.Id != value))
        {
            selectedValue = null;
        }
    }

    private static long? ToNullableLong(object? value)
    {
        if (value is null)
        {
            return null;
        }

        if (value is long longValue)
        {
            return longValue;
        }

        return long.TryParse(value.ToString(), out var parsedValue)
            ? parsedValue
            : null;
    }

    private record EnumOption<TValue>(string Text, TValue Value);
}
