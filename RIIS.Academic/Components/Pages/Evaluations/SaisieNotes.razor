@page "/saisie-notes"
@using Microsoft.AspNetCore.Components.Forms
@using System.Text
@inject ISaisieNotesService SaisieNotesService
@inject IEvaluationsService EvaluationsService
@inject INotesCanevasExcelImportService NotesCanevasExcelImportService
@inject INotesDocumentImportService NotesDocumentImportService
@inject NotificationService NotificationService
@inject NavigationManager Navigation

<RadzenStack Gap="1rem">
    <RadzenCard>
        <RadzenStack Gap="0">
            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0" Text="Saisie des notes" />
            <RadzenText Text="Saisie des notes par classe pédagogique et étudiant, avec export d'un canevas semestriel." />
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenText TextStyle="TextStyle.H6" Text="Sélection de la grille" />
            <RadzenText Text="Sélectionnez l'année, la classe et le semestre pour générer le canevas correspondant. Les filtres UE, EC et type restent facultatifs." />

            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenFormField Text="Année académique" Style="width:100%">
                        <RadzenDropDown TValue="long?" @key="anneesAcademiques" Data="@anneesAcademiques"
                                        TextProperty="Libelle"
                                        ValueProperty="Id"
                                        Value="@selectedAnneeAcademiqueId"
                                        Change="@OnAnneeAcademiqueChanged"
                                        AllowClear="true"
                                        AllowFiltering="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        Placeholder="Toutes les années"
                                        Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenFormField Text="Classe pédagogique (parcours)" Style="width:100%">
                        <RadzenDropDown TValue="long?" @key="selectedAnneeAcademiqueId" Data="@classesPedagogiques"
                                        TextProperty="Libelle"
                                        ValueProperty="Id"
                                        Value="@selectedClassePedagogiqueId"
                                        Change="@OnClassePedagogiqueChanged"
                                        AllowFiltering="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        Placeholder="Sélectionner une classe"
                                        Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenFormField Text="Semestre pédagogique" Style="width:100%">
                        <RadzenDropDown TValue="long?" @key="selectedClassePedagogiqueId" Data="@semestresPedagogiques"
                                        TextProperty="Libelle"
                                        ValueProperty="Id"
                                        Value="@selectedSemestrePedagogiqueId"
                                        Change="@OnSemestreChanged"
                                        AllowClear="true"
                                        AllowFiltering="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        Placeholder="Sélectionner un semestre"
                                        Disabled="@(selectedClassePedagogiqueId is null)"
                                        Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenFormField Text="UE" Style="width:100%">
                        <RadzenDropDown Data="@unitesEnseignement"
                                        TextProperty="Libelle"
                                        ValueProperty="Id"
                                        @bind-Value="@selectedUniteEnseignementId"
                                        Change="@OnUniteEnseignementChanged"
                                        AllowClear="true"
                                        AllowFiltering="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        Placeholder="Sélectionner un semestre d'abord"
                                        Disabled="@(selectedSemestrePedagogiqueId is null)"
                                        Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenFormField Text="EC" Style="width:100%">
                        <RadzenDropDown Data="@elementsConstitutifs"
                                        TextProperty="Libelle"
                                        ValueProperty="Id"
                                        @bind-Value="@selectedElementConstitutifId"
                                        Change="@OnEvaluationFilterChanged"
                                        AllowClear="true"
                                        AllowFiltering="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        Placeholder="Sélectionner une UE"
                                        Disabled="@(selectedSemestrePedagogiqueId is null || selectedUniteEnseignementId is null)"
                                        Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenFormField Text="Type" Style="width:100%">
                        <RadzenDropDown AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Data="@typesEvaluation"
                                        TextProperty="Text"
                                        ValueProperty="Value"
                                        @bind-Value="@selectedTypeEvaluation"
                                        Change="@OnEvaluationFilterChanged"
                                        AllowClear="true"
                                        Placeholder="Tous les types"
                                        Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="9">
                    <RadzenFormField Text="Évaluation ciblée (facultatif)" Style="width:100%">
                        <RadzenDropDown Data="@evaluations"
                                        TextProperty="Libelle"
                                        ValueProperty="Id"
                                        @bind-Value="@selectedEvaluationAcademiqueId"
                                        AllowFiltering="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        Placeholder="Facultatif pour la saisie ciblée"
                                        Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow class="rz-mt-2">
                <RadzenColumn Size="12">
                    <RadzenStack Orientation="Orientation.Horizontal"
                                 AlignItems="AlignItems.Center"
                                 JustifyContent="JustifyContent.End"
                                 Gap="0.5rem"
                                 Style="width:100%; flex-wrap:wrap">
                        <RadzenButton Text="Exporter le canevas"
                                      Icon="download"
                                      ButtonStyle="ButtonStyle.Success"
                                      Click="@ExportCanevas"
                                      Disabled="@(!CanExportCanevas)"
                                      Style="min-width:220px" />
                        <RadzenButton Text="Exporter Options 2"
                                      Icon="assignment"
                                      ButtonStyle="ButtonStyle.Warning"
                                      Click="@ExportOptions2"
                                      Disabled="@(!CanExportCanevas)"
                                      Style="min-width:220px" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>

            @if (!CanExportCanevas)
            {
                <RadzenRow>
                    <RadzenColumn Size="12">
                        <RadzenText TextStyle="TextStyle.Caption"
                                    class="rz-text-align-right"
                                    Text="Sélectionnez une année, une classe et un semestre." />
                    </RadzenColumn>
                </RadzenRow>
            }
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="0.5rem">
            <RadzenText TextStyle="TextStyle.H6" Text="Importer un canevas Excel" />
            <RadzenText Text="Sélectionnez un fichier généré par RIIS Academic après avoir saisi les notes." />
            <div class="riis-file-picker">
                <InputFile id="notes-canevas-file"
                           class="riis-file-picker-input"
                           OnChange="@ImportCanevas"
                           accept=".xlsx" />
                <label for="notes-canevas-file" class="riis-file-picker-button">
                    <RadzenIcon Icon="upload_file" />
                    <span>Choisir un fichier Excel</span>
                </label>
                <span class="riis-file-picker-name">@selectedFileName</span>
            </div>
            @if (importResult is not null && !importResult.IsValid)
            {
                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-danger" Text="@ImportErrorsText" />
            }
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.H6" Text="Importer une fiche Word ou un scan" />
            <RadzenText Text="Chargez une fiche de report Word ou un document numérisé respectant le modèle : Matricules, Noms et prénoms, Notes/20." />
            <div class="riis-file-picker">
                <InputFile id="notes-document-file"
                           class="riis-file-picker-input"
                           OnChange="@AnalyseNotesDocument"
                           accept=".docx,.pdf,.png,.jpg,.jpeg,.tif,.tiff" />
                <label for="notes-document-file" class="riis-file-picker-button">
                    <RadzenIcon Icon="document_scanner" />
                    <span>Choisir une fiche Word ou un scan</span>
                </label>
                <span class="riis-file-picker-name">@selectedNotesDocumentFileName</span>
            </div>

            @if (notesDocumentPreview is not null)
            {
                <RadzenAlert AlertStyle="@(notesDocumentPreview.IsValid ? AlertStyle.Info : AlertStyle.Warning)"
                             Variant="Variant.Flat"
                             ShowIcon="true">
                    @if (notesDocumentPreview.IsValid)
                    {
                        <span>@notesDocumentPreview.Lignes.Count ligne(s) extraite(s) depuis @notesDocumentPreview.SourceFormat.</span>
                    }
                    else
                    {
                        <span>@string.Join(" | ", notesDocumentPreview.Errors)</span>
                    }
                </RadzenAlert>

                @if (notesDocumentPreview.TypeEvaluationExtrait is not null
                    || !string.IsNullOrWhiteSpace(notesDocumentPreview.CycleLibelleExtrait)
                    || !string.IsNullOrWhiteSpace(notesDocumentPreview.FiliereLibelleExtrait)
                    || !string.IsNullOrWhiteSpace(notesDocumentPreview.ClasseLibelleExtrait)
                    || notesDocumentPreview.NumeroSemestreExtrait is not null
                    || !string.IsNullOrWhiteSpace(notesDocumentPreview.UniteEnseignementExtrait)
                    || !string.IsNullOrWhiteSpace(notesDocumentPreview.ElementConstitutifExtrait))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" ShowIcon="true">
                        <span>
                            Métadonnées détectées :
                            @(!string.IsNullOrWhiteSpace(notesDocumentPreview.AnneeAcademiqueLibelleExtrait) ? $"Année {notesDocumentPreview.AnneeAcademiqueLibelleExtrait} | " : "")
                            @(notesDocumentPreview.TypeEvaluationExtrait is null ? "Type non détecté" : GetTypeEvaluationLibelle(notesDocumentPreview.TypeEvaluationExtrait.Value))
                            @(!string.IsNullOrWhiteSpace(notesDocumentPreview.CycleLibelleExtrait) ? $" | Cycle {notesDocumentPreview.CycleLibelleExtrait}" : "")
                            @(!string.IsNullOrWhiteSpace(notesDocumentPreview.FiliereLibelleExtrait) ? $" | Filière {notesDocumentPreview.FiliereLibelleExtrait}" : "")
                            @(!string.IsNullOrWhiteSpace(notesDocumentPreview.ClasseLibelleExtrait) ? $" | Classe {notesDocumentPreview.ClasseLibelleExtrait}" : "")
                            @(notesDocumentPreview.NumeroSemestreExtrait is not null ? $" | Semestre {notesDocumentPreview.NumeroSemestreExtrait}" : "")
                            @(!string.IsNullOrWhiteSpace(notesDocumentPreview.UniteEnseignementExtrait) ? $" | UE {notesDocumentPreview.UniteEnseignementExtrait}" : "")
                            @(!string.IsNullOrWhiteSpace(notesDocumentPreview.ElementConstitutifExtrait) ? $" | EC {notesDocumentPreview.ElementConstitutifExtrait}" : "")
                        </span>
                    </RadzenAlert>
                }

                @if (notesDocumentPreview.Warnings.Count > 0)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" ShowIcon="true">
                        @string.Join(" | ", notesDocumentPreview.Warnings)
                    </RadzenAlert>
                }

                @if (notesDocumentPreview.Lignes.Count > 0)
                {
                    <RadzenDataGrid Data="@notesDocumentPreview.Lignes"
                                    TItem="NotesDocumentRowDto"
                                    AllowPaging="true"
                                    AllowSorting="true"
                                    AllowColumnResize="true"
                                    PageSize="10">
                        <Columns>
                            <RadzenDataGridColumn TItem="NotesDocumentRowDto" Property="Numero" Title="N°" Width="70px" />
                            <RadzenDataGridColumn TItem="NotesDocumentRowDto" Property="Matricule" Title="Matricule" Width="160px" />
                            <RadzenDataGridColumn TItem="NotesDocumentRowDto" Property="NomComplet" Title="Nom et prénoms" />
                            <RadzenDataGridColumn TItem="NotesDocumentRowDto" Title="Note /20" Width="150px" Sortable="false" Filterable="false">
                                <Template Context="ligne">
                                    <div class="riis-note-editor">
                                        <RadzenButton Icon="remove"
                                                      Size="ButtonSize.Small"
                                                      ButtonStyle="ButtonStyle.Light"
                                                      Variant="Variant.Flat"
                                                      Click="@(() => AdjustDocumentNote(ligne, -0.25m))"
                                                      Disabled="@(ligne.Valeur <= 0m)" />
                                        <InputNumber TValue="decimal?"
                                                     @bind-Value="ligne.Valeur"
                                                     min="0"
                                                     max="20"
                                                     step="0.25"
                                                     class="riis-note-input"
                                                     disabled="@(ligne.StatutPresence != StatutPresenceEvaluation.Present)" />
                                        <RadzenButton Icon="add"
                                                      Size="ButtonSize.Small"
                                                      ButtonStyle="ButtonStyle.Light"
                                                      Variant="Variant.Flat"
                                                      Click="@(() => AdjustDocumentNote(ligne, 0.25m))"
                                                      Disabled="@(ligne.Valeur >= 20m)" />
                                    </div>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="NotesDocumentRowDto" Title="Contrôle" Sortable="false" Filterable="false">
                                <Template Context="ligne">
                                    @{
                                        TypeEvaluation? typeControle = notesDocumentPreview.TypeEvaluationExtrait
                                            ?? selectedTypeEvaluation
                                            ?? TypeEvaluation.SessionNormale;
                                    }
                                    @if (!string.IsNullOrWhiteSpace(ligne.Erreur))
                                    {
                                        <span class="rz-color-danger">@ligne.Erreur</span>
                                    }
                                    else if (typeControle is not null)
                                    {
                                        <span>@GetTypeEvaluationLibelle(typeControle.Value)</span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                }

                <RadzenStack Orientation="Orientation.Horizontal"
                             JustifyContent="JustifyContent.End"
                             Gap="0.5rem"
                             Style="flex-wrap:wrap">
                    <RadzenButton Text="Effacer l'aperçu"
                                  Icon="clear"
                                  ButtonStyle="ButtonStyle.Light"
                                  Click="@ClearNotesDocumentPreview" />
                    <RadzenButton Text="Enregistrer les notes"
                                  Icon="save"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="@ImporterNotesDocument"
                                  Disabled="@(!CanImportNotesDocument || notesDocumentImporting)" />
                </RadzenStack>
                @if (!CanImportNotesDocument && !notesDocumentImporting)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" ShowIcon="true">
                        @NotesDocumentImportState
                    </RadzenAlert>
                }
            }
        </RadzenStack>
    </RadzenCard>

    @if (showMissingEvaluationForm)
    {
        <div class="riis-modal-backdrop">
            <RadzenCard class="riis-modal">
                <RadzenTemplateForm TItem="EvaluationAcademiqueDto"
                                    Data="@missingEvaluationModel"
                                    Submit="@SaveMissingEvaluation">
                    <RadzenStack Gap="1rem">
                        <RadzenText TextStyle="TextStyle.H6"
                                    TagName="TagName.H2"
                                    class="riis-modal-title rz-m-0">
                            Nouvelle évaluation détectée
                        </RadzenText>

                        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" ShowIcon="true">
                            Aucune évaluation de type
                            <strong>@GetTypeEvaluationLibelle(missingEvaluationModel.Type)</strong>
                            n'existe encore pour cet EC. Enregistrez-la pour poursuivre l'import des notes.
                        </RadzenAlert>

                        <RadzenRow>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Parcours académique" Style="width:100%">
                                    <RadzenTextBox Value="@missingEvaluationModel.ParcoursAcademiqueLibelle"
                                                   Disabled="true"
                                                   Style="width:100%" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="3">
                                <RadzenFormField Text="Semestre" Style="width:100%">
                                    <RadzenTextBox Value="@missingEvaluationModel.SemestrePedagogiqueLibelle"
                                                   Disabled="true"
                                                   Style="width:100%" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="3">
                                <RadzenFormField Text="Type" Style="width:100%">
                                    <RadzenTextBox Value="@GetTypeEvaluationLibelle(missingEvaluationModel.Type)"
                                                   Disabled="true"
                                                   Style="width:100%" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenRow>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="UE" Style="width:100%">
                                    <RadzenTextBox Value="@missingEvaluationModel.UniteEnseignementLibelle"
                                                   Disabled="true"
                                                   Style="width:100%" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="EC" Style="width:100%">
                                    <RadzenTextBox Value="@missingEvaluationModel.ElementConstitutifLibelle"
                                                   Disabled="true"
                                                   Style="width:100%" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenRow>
                            <RadzenColumn Size="12" SizeMD="3">
                                <RadzenFormField Text="Numéro" Style="width:100%">
                                    <RadzenNumeric @bind-Value="missingEvaluationModel.Numero" Disabled="true" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="3">
                                <RadzenFormField Text="Barème" Style="width:100%">
                                    <RadzenNumeric @bind-Value="missingEvaluationModel.Bareme" Min="1" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="3">
                                <RadzenFormField Text="Pondération %" Style="width:100%">
                                    <RadzenNumeric @bind-Value="missingEvaluationModel.PonderationPourcentage" Min="0" Max="100" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="3">
                                <RadzenFormField Text="Date" Style="width:100%">
                                    <RadzenDatePicker @bind-Value="missingEvaluationModel.DateEvaluation"
                                                      DateFormat="dd/MM/yyyy"
                                                      Style="width:100%" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenFormField Text="Observation" Style="width:100%">
                            <RadzenTextArea @bind-Value="missingEvaluationModel.Observation" Rows="3" />
                        </RadzenFormField>

                        <RadzenStack Orientation="Orientation.Horizontal"
                                     JustifyContent="JustifyContent.End"
                                     Gap="0.5rem">
                            <RadzenButton Text="Annuler"
                                          Icon="close"
                                          ButtonStyle="ButtonStyle.Light"
                                          Click="@CancelMissingEvaluation"
                                          Disabled="@savingMissingEvaluation" />
                            <RadzenButton Text="Enregistrer l'évaluation"
                                          Icon="save"
                                          ButtonType="ButtonType.Submit"
                                          ButtonStyle="ButtonStyle.Primary"
                                          Disabled="@savingMissingEvaluation" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenTemplateForm>
            </RadzenCard>
        </div>
    }

    @if (grille is not null)
    {
        <RadzenCard>
            <RadzenStack Gap="0.5rem">
                <RadzenText TextStyle="TextStyle.H6" Text="@grille.EvaluationLibelle" />
                <RadzenText Text="@($"{grille.AnneeAcademiqueLibelle} | {grille.ClassePedagogiqueLibelle} | {grille.UniteEnseignementLibelle} | {grille.ElementConstitutifLibelle}")" />
                <RadzenText Text="@($"Barème : {grille.Bareme:N2} / Pondération : {grille.PonderationPourcentage:N2} %")" />

                @if (!string.IsNullOrWhiteSpace(grille.Avertissement))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" ShowIcon="true">
                        @grille.Avertissement
                    </RadzenAlert>
                }

                @if (grille.TypeEvaluation == TypeEvaluation.SessionRattrapage)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" ShowIcon="true">
                        Pour une SR, la grille est limitée aux étudiants dont les crédits semestriels calculés sont insuffisants. Si aucun calcul n'existe encore, tous les étudiants sont affichés provisoirement.
                    </RadzenAlert>
                }
            </RadzenStack>
        </RadzenCard>

        <RadzenCard>
<RadzenDataGrid @ref="saisieNotesGrid" Data="@grille.Lignes" TItem="SaisieNoteLigneDto" AllowPaging="true" AllowSorting="true" AllowColumnResize="true" AllowFiltering="true" PageSize="20">
                <Columns>
                    <RadzenDataGridColumn TItem="SaisieNoteLigneDto" Property="Matricule" Title="Matricule" Width="140px" />
                    <RadzenDataGridColumn TItem="SaisieNoteLigneDto" Property="NomComplet" Title="Étudiant" />
                    <RadzenDataGridColumn TItem="SaisieNoteLigneDto" Title="Note" Width="160px" Sortable="false" Filterable="false">
                        <Template Context="ligne">
                            <div class="riis-note-editor">
                                <RadzenButton Icon="remove"
                                              Size="ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Light"
                                              Variant="Variant.Flat"
                                              Click="@(() => AdjustSaisieNote(ligne, -0.25m))"
                                              Disabled="@(ligne.Valeur <= 0m)" />
                                <InputNumber TValue="decimal?"
                                             @bind-Value="ligne.Valeur"
                                             min="0"
                                             max="@grille.Bareme"
                                             step="0.25"
                                             class="riis-note-input"
                                             disabled="@(ligne.StatutPresence != StatutPresenceEvaluation.Present)" />
                                <RadzenButton Icon="add"
                                              Size="ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Light"
                                              Variant="Variant.Flat"
                                              Click="@(() => AdjustSaisieNote(ligne, 0.25m))"
                                              Disabled="@(ligne.Valeur >= grille.Bareme)" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SaisieNoteLigneDto" Title="Présence" Width="220px" Sortable="false" Filterable="false">
                        <Template Context="ligne">
                            <RadzenDropDown AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Data="@statutsPresence"
                                            TextProperty="Text"
                                            ValueProperty="Value"
                                            @bind-Value="@ligne.StatutPresence"
                                            Change="@(_ => OnPresenceChanged(ligne))"
                                            Style="width:100%" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SaisieNoteLigneDto" Title="Crédits semestre" Width="160px">
                        <Template Context="ligne">
                            @if (ligne.CreditsSemestreAcquis is null || ligne.CreditsSemestreRequis is null)
                            {
                                <span>-</span>
                            }
                            else
                            {
                                <span>@($"{ligne.CreditsSemestreAcquis:N0}/{ligne.CreditsSemestreRequis:N0}")</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SaisieNoteLigneDto" Title="Observation" Sortable="false" Filterable="false">
                        <Template Context="ligne">
                            <RadzenTextBox @bind-Value="@ligne.Observation" Style="width:100%" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="rz-mt-4">
                <RadzenButton Text="Recharger" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="@LoadGrille" />
                <RadzenButton Text="Enregistrer les notes" Icon="save" ButtonStyle="ButtonStyle.Primary" Click="@SaveNotes" Disabled="@(grille.Lignes.Count == 0)" />
            </RadzenStack>
        </RadzenCard>
    }
</RadzenStack>

@code {
    [SupplyParameterFromQuery(Name = "evaluationId")]
    public long? EvaluationId { get; set; }

    private List<LookupDto> anneesAcademiques = [];
    private List<LookupDto> classesPedagogiques = [];
    private List<LookupDto> semestresPedagogiques = [];
    private List<LookupDto> unitesEnseignement = [];
    private List<LookupDto> elementsConstitutifs = [];
    private List<LookupDto> evaluations = [];
    private RadzenDataGrid<SaisieNoteLigneDto>? saisieNotesGrid;
    private SaisieNotesGrilleDto? grille;
    private NotesCanevasImportResultDto? importResult;
    private NotesDocumentPreviewDto? notesDocumentPreview;
    private NotesDocumentImportResultDto? notesDocumentImportResult;
    private EvaluationAcademiqueDto missingEvaluationModel = new();
    private long? selectedAnneeAcademiqueId;
    private long? selectedClassePedagogiqueId;
    private long? selectedSemestrePedagogiqueId;
    private long? selectedUniteEnseignementId;
    private long? selectedElementConstitutifId;
    private long? selectedEvaluationAcademiqueId;
    private TypeEvaluation? selectedTypeEvaluation;
    private string selectedFileName = "Aucun fichier sélectionné";
    private string selectedNotesDocumentFileName = "Aucun document sélectionné";
    private bool notesDocumentImporting;
    private bool showMissingEvaluationForm;
    private bool savingMissingEvaluation;

    private bool CanLoadGrille => selectedEvaluationAcademiqueId is not null && selectedClassePedagogiqueId is not null;
    private bool CanExportCanevas => selectedAnneeAcademiqueId is not null
        && selectedClassePedagogiqueId is not null
        && selectedSemestrePedagogiqueId is not null;
    private string ImportErrorsText => importResult is null ? string.Empty : string.Join(" | ", importResult.Errors);
    private string NotesDocumentImportState
    {
        get
        {
            if (notesDocumentPreview is null)
            {
                return "Sélectionnez une fiche Word ou un scan.";
            }

            var missing = new List<string>();
            if (!notesDocumentPreview.IsValid) missing.Add("un aperçu valide");
            if (selectedAnneeAcademiqueId is null) missing.Add("l'année académique");
            if (selectedClassePedagogiqueId is null) missing.Add("la classe");
            if (selectedSemestrePedagogiqueId is null) missing.Add("le semestre");
            if (selectedElementConstitutifId is null
                && !HasExtractedElementMetadata(notesDocumentPreview.ElementConstitutifExtrait))
            {
                missing.Add("l'EC");
            }

            if (selectedEvaluationAcademiqueId is null)
            {
                missing.Add(selectedTypeEvaluation is null
                    ? "le type d'évaluation"
                    : evaluations.Count == 0
                        ? "l'évaluation à créer"
                        : "l'évaluation ciblée");
            }

            return missing.Count == 0
                ? "L'import est prêt."
                : $"Import en attente : sélectionnez ou corrigez {string.Join(", ", missing)}.";
        }
    }
    // Le document contient le contexte lorsqu'il a été résolu dans les listes
    // ou lorsque les métadonnées Word permettent encore de le résoudre au clic.
    // Cela évite de laisser le bouton désactivé alors que la fiche est complète.
    private bool CanImportNotesDocument => notesDocumentPreview?.IsValid == true
        && (selectedAnneeAcademiqueId is not null
            || !string.IsNullOrWhiteSpace(notesDocumentPreview.AnneeAcademiqueLibelleExtrait))
        && (selectedClassePedagogiqueId is not null
            || !string.IsNullOrWhiteSpace(notesDocumentPreview.ClasseLibelleExtrait))
        && (selectedSemestrePedagogiqueId is not null
            || notesDocumentPreview.NumeroSemestreExtrait is not null)
        && (selectedElementConstitutifId is not null
            || HasExtractedElementMetadata(notesDocumentPreview.ElementConstitutifExtrait))
        && selectedEvaluationAcademiqueId is not null;

    private bool HasResolvedNotesDocumentContext => selectedAnneeAcademiqueId is not null
        && selectedClassePedagogiqueId is not null
        && selectedSemestrePedagogiqueId is not null
        && (selectedElementConstitutifId is not null
            || HasExtractedElementMetadata(notesDocumentPreview?.ElementConstitutifExtrait))
        && (selectedEvaluationAcademiqueId is not null || selectedTypeEvaluation is not null);

    private readonly List<EnumOption<TypeEvaluation>> typesEvaluation =
    [
        new("CCON - Contrôle continu", TypeEvaluation.ControleContinu),
        new("CC - Contrôle de connaissance", TypeEvaluation.ControleConnaissance),
        new("SN - Session normale", TypeEvaluation.SessionNormale),
        new("SR - Session de rattrapage", TypeEvaluation.SessionRattrapage)
    ];

    private readonly List<EnumOption<StatutPresenceEvaluation>> statutsPresence =
    [
        new("Présent", StatutPresenceEvaluation.Present),
        new("Absence justifiée", StatutPresenceEvaluation.AbsenceJustifiee),
        new("Absence non justifiée", StatutPresenceEvaluation.AbsenceNonJustifiee),
        new("Dispense", StatutPresenceEvaluation.Dispense)
    ];

    protected override async Task OnInitializedAsync()
    {
        anneesAcademiques = await SaisieNotesService.GetAnneesAcademiquesLookupAsync();

        if (EvaluationId is long evaluationId
            && await InitializeFromEvaluationAsync(evaluationId))
        {
            return;
        }

        selectedAnneeAcademiqueId = anneesAcademiques.FirstOrDefault()?.Id;
        await RefreshClassesAsync();
        await RefreshElementsConstitutifsAsync();
        await RefreshEvaluationsAsync();
    }

    private async Task<bool> InitializeFromEvaluationAsync(long evaluationId)
    {
        var context = await SaisieNotesService.GetEvaluationContextForEvaluationAsync(evaluationId);
        if (context is null)
        {
            NotifyError("Impossible de retrouver la classe pédagogique associée à cette évaluation.");
            return false;
        }

        selectedAnneeAcademiqueId = context.AnneeAcademiqueId;
        selectedClassePedagogiqueId = context.ClassePedagogiqueId;
        selectedSemestrePedagogiqueId = context.SemestrePedagogiqueId;
        selectedUniteEnseignementId = context.UniteEnseignementId;
        selectedElementConstitutifId = context.ElementConstitutifId;
        selectedEvaluationAcademiqueId = evaluationId;

        await RefreshClassesAsync();
        await RefreshSemestresAsync();
        await RefreshUnitesEnseignementAsync();
        await RefreshElementsConstitutifsAsync();
        await RefreshEvaluationsAsync();
        await LoadGrille();
        return grille is not null;
    }

