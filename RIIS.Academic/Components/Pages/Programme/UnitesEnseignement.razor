@page "/programme/ue"
@inject IProgrammePedagogiqueService ProgrammeService
@inject NotificationService NotificationService

<RadzenStack Gap="1rem">
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
            <RadzenStack Gap="0">
                <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0" Text="Unités d'enseignement" />
                <RadzenText Text="Catalogue autonome des UE et de leurs EC." />
            </RadzenStack>
            <RadzenButton Text="Nouvelle UE" Icon="add_circle" Click="@CreateUe" ButtonStyle="ButtonStyle.Primary" />
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.75rem" Wrap="FlexWrap.Wrap">
            <RadzenFormField Text="Filtrer par UE" Style="width: min(100%, 520px)">
                <RadzenDropDown Data="@ueOptions"
                                TextProperty="Libelle"
                                ValueProperty="Id"
                                @bind-Value="@selectedUniteEnseignementId"
                                Change="@OnUniteEnseignementFilterChanged"
                                AllowClear="true"
                                AllowFiltering="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Placeholder="Toutes les UE"
                                Style="width:100%" />
            </RadzenFormField>
            <RadzenButton Text="Réinitialiser" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="@ResetFilter" />
        </RadzenStack>
    </RadzenCard>

    @if (showUeForm)
    {
        <div class="riis-modal-backdrop">
            <RadzenCard class="riis-modal">
            <RadzenTemplateForm TItem="UniteEnseignementDto" Data="@ueModel" Submit="@SaveUe">
                <RadzenStack Gap="1rem">
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="riis-modal-title rz-m-0">@(ueModel.Id == 0 ? "Nouvelle UE" : "Modifier l'UE")</RadzenText>

                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenFormField Text="Code" Style="width:100%">
                                <RadzenTextBox @bind-Value="@ueModel.Code" Name="Code" @oninput="@OnUeCodeInput" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="Code" Text="Code obligatoire." />
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeMD="9">
                            <RadzenFormField Text="Libellé" Style="width:100%">
                                <RadzenTextBox @bind-Value="@ueModel.Libelle" Name="Libelle" @oninput="@OnUeLibelleInput" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="Libelle" Text="Libellé obligatoire." />
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenFormField Text="Maquette pédagogique" Style="width:100%">
                        <RadzenDropDown Data="@maquettes"
                                        TextProperty="Libelle"
                                        ValueProperty="Id"
                                        TValue="long?"
                                        @bind-Value="@ueModel.MaquettePedagogiqueId"
                                        Name="MaquettePedagogiqueId"
                                        Placeholder="Sélectionner une maquette"
                                        AllowFiltering="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        AllowClear="true"
                                        Style="width:100%" />
                    </RadzenFormField>
                    <RadzenRequiredValidator Component="MaquettePedagogiqueId" Text="La maquette pédagogique est obligatoire." />

                    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" ShowIcon="true">
                        Les crédits et le volume horaire de cette UE sont calculés automatiquement à partir de ses EC.
                    </RadzenAlert>

                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                        <RadzenButton Text="Annuler" Icon="close" ButtonStyle="ButtonStyle.Light" Click="@CancelUe" />
                        <RadzenButton Text="Enregistrer UE" Icon="save" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenTemplateForm>
            </RadzenCard>
        </div>
    }

    <RadzenCard>
        <RadzenDataGrid @ref="unitesGrid" Data="@items" TItem="UniteEnseignementDto" AllowPaging="true" AllowSorting="true" AllowColumnResize="true" AllowFiltering="false" PageSize="10">
            <Columns>
                <RadzenDataGridColumn TItem="UniteEnseignementDto" Property="Code" Title="Code" Width="120px" />
                <RadzenDataGridColumn TItem="UniteEnseignementDto" Property="Libelle" Title="UE (Unité d'enseignement)" />
                <RadzenDataGridColumn TItem="UniteEnseignementDto" Property="MaquettePedagogiqueLibelle" Title="Maquette pédagogique" />
                <RadzenDataGridColumn TItem="UniteEnseignementDto" Property="Credits" Title="Crédits" Width="110px" />
                <RadzenDataGridColumn TItem="UniteEnseignementDto" Property="VolumeHoraire" Title="VH" Width="90px" />
                <RadzenDataGridColumn TItem="UniteEnseignementDto" Title="EC" Width="90px">
                    <Template Context="item">
                        @item.ElementsConstitutifs.Count
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="UniteEnseignementDto" Title="Actions" Width="150px" Sortable="false" Filterable="false">
                    <Template Context="item">
                        <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => EditUe(item))" />
                        <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Click="@(() => DeleteUe(item))" class="rz-ml-1" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
            <Template Context="ue">
                <RadzenCard class="rz-m-2">
                    @if (ue.ElementsConstitutifs.Count == 0)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" ShowIcon="true">
                            Aucun EC n'est encore rattaché à cette UE.
                        </RadzenAlert>
                    }
                    else
                    {
                        <RadzenDataGrid Data="@ue.ElementsConstitutifs" TItem="ElementConstitutifDto" AllowPaging="false" AllowSorting="true" AllowColumnResize="true">
                            <Columns>
                                <RadzenDataGridColumn TItem="ElementConstitutifDto" Property="Code" Title="Code" Width="120px" />
                                <RadzenDataGridColumn TItem="ElementConstitutifDto" Property="Libelle" Title="EC (Élément constitutif)" />
                                <RadzenDataGridColumn TItem="ElementConstitutifDto" Property="Type" Title="Type" Width="130px" />
                                <RadzenDataGridColumn TItem="ElementConstitutifDto" Property="Credits" Title="Crédits" Width="110px" />
                                <RadzenDataGridColumn TItem="ElementConstitutifDto" Property="VolumeHoraire" Title="VH" Width="90px" />
                            </Columns>
                        </RadzenDataGrid>
                    }
                </RadzenCard>
            </Template>
        </RadzenDataGrid>
    </RadzenCard>
</RadzenStack>

@code {
    private List<UniteEnseignementDto> allItems = [];
    private List<UniteEnseignementDto> items = [];
    private RadzenDataGrid<UniteEnseignementDto>? unitesGrid;
    private List<LookupDto> ueOptions = [];
    private List<LookupDto> maquettes = [];
    private UniteEnseignementDto ueModel = new();
    private long? selectedUniteEnseignementId;
    private bool showUeForm;
    private bool ueCodeWasManuallyEdited;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private Task OnUniteEnseignementFilterChanged(object? _)
    {
        ApplyFilter();
        return ReloadGridAsync();
    }

    private Task ResetFilter()
    {
        selectedUniteEnseignementId = null;
        showUeForm = false;
        ApplyFilter();
        return ReloadGridAsync();
    }

    private async Task Load()
    {
        maquettes = await ProgrammeService.GetMaquettesLookupAsync();
        allItems = await ProgrammeService.GetUnitesEnseignementAsync();
        ueOptions = allItems
            .OrderBy(x => x.Code)
            .ThenBy(x => x.Libelle)
            .Select(x => new LookupDto { Id = x.Id, Libelle = x.SelectionLabel })
            .ToList();
        ApplyFilter();
        await ReloadGridAsync();
    }

    private Task ReloadGridAsync()
        => unitesGrid is null ? Task.CompletedTask : unitesGrid.Reload();

    private void ApplyFilter()
    {
        items = selectedUniteEnseignementId is null
            ? allItems.ToList()
            : allItems.Where(x => x.Id == selectedUniteEnseignementId.Value).ToList();
    }

    private async Task CreateUe()
    {
        ueModel = await ProgrammeService.CreateDefaultUniteEnseignementAsync();
        ueCodeWasManuallyEdited = false;
        showUeForm = true;
    }

    private void EditUe(UniteEnseignementDto item)
    {
        ueModel = new UniteEnseignementDto
        {
            Id = item.Id,
            MaquettePedagogiqueId = item.MaquettePedagogiqueId,
            MaquettePedagogiqueLibelle = item.MaquettePedagogiqueLibelle,
            Code = item.Code,
            Libelle = item.Libelle,
            Credits = item.Credits,
            VolumeHoraire = item.VolumeHoraire,
            NombreElementsConstitutifs = item.ElementsConstitutifs.Count
        };

        ueCodeWasManuallyEdited = true;
        showUeForm = true;
    }

    private async Task OnUeLibelleInput(ChangeEventArgs args)
    {
        ueModel.Libelle = args.Value?.ToString() ?? string.Empty;

        if (!ueCodeWasManuallyEdited)
        {
            ueModel.Code = await ProgrammeService.GenerateUniteEnseignementCodeAsync(ueModel.Libelle, ueModel.Id);
        }
    }

    private void OnUeCodeInput(ChangeEventArgs args)
    {
        ueModel.Code = args.Value?.ToString() ?? string.Empty;
        ueCodeWasManuallyEdited = true;
    }

    private async Task SaveUe(UniteEnseignementDto _)
    {
        try
        {
            await ProgrammeService.SaveUniteEnseignementAsync(ueModel);
            NotifySuccess();
            showUeForm = false;
            await Load();
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
    }

    private async Task DeleteUe(UniteEnseignementDto item)
    {
        try
        {
            await ProgrammeService.DeleteUniteEnseignementAsync(item.Id);
            await Load();
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
    }

    private void CancelUe() => showUeForm = false;

    private void NotifySuccess() => NotificationService.Notify(NotificationSeverity.Success, "Succès", "Données enregistrées.");

    private void NotifyError(string message) => NotificationService.Notify(NotificationSeverity.Error, "Erreur", message);

}
