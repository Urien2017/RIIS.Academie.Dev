@page "/programme/ec"
@inject IProgrammePedagogiqueService ProgrammeService
@inject NotificationService NotificationService

<RadzenStack Gap="1rem">
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
            <RadzenStack Gap="0">
                <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0" Text="Éléments constitutifs" />
                <RadzenText Text="Gestion des EC/matières du catalogue avec leurs crédits et volumes horaires." />
            </RadzenStack>
            <RadzenButton Text="Nouvel EC" Icon="add_circle" Click="@Create" ButtonStyle="ButtonStyle.Primary" />
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.75rem" Wrap="FlexWrap.Wrap">
            <RadzenFormField Text="Filtrer par EC" Style="width: min(100%, 520px)">
                <RadzenDropDown Data="@ecOptions"
                                TextProperty="Libelle"
                                ValueProperty="Id"
                                @bind-Value="@selectedElementConstitutifId"
                                Change="@OnElementConstitutifFilterChanged"
                                AllowClear="true"
                                AllowFiltering="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Placeholder="Tous les EC"
                                Style="width:100%" />
            </RadzenFormField>
            <RadzenButton Text="Réinitialiser" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="@ResetFilter" />
        </RadzenStack>
    </RadzenCard>

    @if (showForm)
    {
        <div class="riis-modal-backdrop">
            <RadzenCard class="riis-modal">
            <RadzenTemplateForm TItem="ElementConstitutifDto" Data="@model" Submit="@Save">
                <RadzenStack Gap="1rem">
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="riis-modal-title rz-m-0">@(model.Id == 0 ? "Nouvel EC" : "Modifier l'EC")</RadzenText>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="UE" Style="width:100%">
                                <RadzenDropDown AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Data="@unitesEnseignement" TextProperty="Libelle" ValueProperty="Id" @bind-Value="@formUniteEnseignementId" TValue="long?" Change="@OnFormUniteEnseignementChanged" Name="UniteEnseignementId" Placeholder="Sélectionner une UE" Style="width:100%" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="UniteEnseignementId" Text="UE obligatoire." />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="2">
                            <RadzenFormField Text="Code" Style="width:100%">
                                <RadzenTextBox @bind-Value="@model.Code" Name="Code" @oninput="@OnCodeInput" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenFormField Text="Libellé" Style="width:100%">
                                <RadzenTextBox @bind-Value="@model.Libelle" Name="Libelle" @oninput="@OnLibelleInput" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="Libelle" Text="Libellé obligatoire." />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="2">
                            <RadzenFormField Text="Type" Style="width:100%">
                                <RadzenDropDown AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Data="@types" TextProperty="Text" ValueProperty="Value" @bind-Value="@formType" TValue="TypeElementConstitutif?" Name="Type" Placeholder="Sélectionner un type" Style="width:100%" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="Type" Text="Type obligatoire." />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="2">
                            <RadzenFormField Text="Crédits" Style="width:100%">
                                <RadzenNumeric @bind-Value="@formCredits" TValue="decimal?" Min="0" Step="0.5" Name="Credits" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="2">
                            <RadzenFormField Text="Heures" Style="width:100%">
                                <RadzenNumeric @bind-Value="@formVolumeHoraire" TValue="short?" Min="0" Step="1" Name="VolumeHoraire" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                        <RadzenButton Text="Annuler" Icon="close" ButtonStyle="ButtonStyle.Light" Click="@Cancel" />
                        <RadzenButton Text="Enregistrer" Icon="save" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenTemplateForm>
            </RadzenCard>
        </div>
    }

    <RadzenCard>
        <RadzenDataGrid @ref="elementsGrid" Data="@items" TItem="ElementConstitutifDto" AllowPaging="true" AllowSorting="true" AllowColumnResize="true" AllowFiltering="false" PageSize="10">
            <Columns>
                <RadzenDataGridColumn TItem="ElementConstitutifDto" Property="Code" Title="Code" Width="120px" />
                <RadzenDataGridColumn TItem="ElementConstitutifDto" Property="Libelle" Title="EC (Élément constitutif)" />
                <RadzenDataGridColumn TItem="ElementConstitutifDto" Property="Type" Title="Type" Width="120px" />
                <RadzenDataGridColumn TItem="ElementConstitutifDto" Property="Credits" Title="Crédits" Width="110px" />
                <RadzenDataGridColumn TItem="ElementConstitutifDto" Property="VolumeHoraire" Title="Heures" Width="110px" />
                <RadzenDataGridColumn TItem="ElementConstitutifDto" Property="UniteEnseignementLibelle" Title="UE (Unité d'enseignement)" />
                <RadzenDataGridColumn TItem="ElementConstitutifDto" Title="Actions" Width="160px" Sortable="false" Filterable="false">
                    <Template Context="item">
                        <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => Edit(item))" />
                        <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Click="@(() => Delete(item))" class="rz-ml-1" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</RadzenStack>

@code {
    private List<ElementConstitutifDto> items = [];
    private RadzenDataGrid<ElementConstitutifDto>? elementsGrid;
    private List<LookupDto> unitesEnseignement = [];
    private List<LookupDto> ecOptions = [];
    private ElementConstitutifDto model = new();
    private long? selectedElementConstitutifId;
    private long? formUniteEnseignementId;
    private TypeElementConstitutif? formType;
    private decimal? formCredits;
    private short? formVolumeHoraire;
    private bool showForm;
    private bool codeWasManuallyEdited;

    private readonly List<EnumOption<TypeElementConstitutif>> types =
    [
        new("Cours Magistraux (CM)", TypeElementConstitutif.CoursMagistraux),
        new("Travaux Dirigés (TD)", TypeElementConstitutif.TravauxDiriges),
        new("Travaux Pratiques (TP)", TypeElementConstitutif.TravauxPratiques),
        new("Séminaire", TypeElementConstitutif.Seminaire),
        new("Projet / Atelier", TypeElementConstitutif.ProjetAtelier),
        new("Enseignement en ligne (E-learning)", TypeElementConstitutif.EnseignementEnLigne),
        new("Stage et Immersion professionnelle", TypeElementConstitutif.StageImmersion)
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadLookups();
        await Load();
    }

    private async Task LoadLookups()
    {
        unitesEnseignement = await ProgrammeService.GetUnitesEnseignementLookupAsync();
        ecOptions = (await ProgrammeService.GetElementsConstitutifsAsync())
            .OrderBy(x => x.Code)
            .ThenBy(x => x.Libelle)
            .Select(x => new LookupDto
            {
                Id = x.Id,
                Libelle = $"{x.Code} - {x.Libelle} | {x.UniteEnseignementLibelle}"
            })
            .ToList();
    }

    private async Task Load()
    {
        var allItems = await ProgrammeService.GetElementsConstitutifsAsync();
        items = selectedElementConstitutifId is null
            ? allItems
            : allItems.Where(x => x.Id == selectedElementConstitutifId.Value).ToList();
        if (elementsGrid is not null) await elementsGrid.Reload();
    }

    private async Task OnElementConstitutifFilterChanged(object? _)
    {
        await Load();
    }

    private async Task ResetFilter()
    {
        selectedElementConstitutifId = null;
        await Load();
    }

    private async Task Create()
    {
        model = new ElementConstitutifDto();
        formUniteEnseignementId = null;
        formType = null;
        formCredits = null;
        formVolumeHoraire = null;
        codeWasManuallyEdited = false;
        showForm = true;
    }

    private void Edit(ElementConstitutifDto item)
    {
        model = new ElementConstitutifDto
        {
            Id = item.Id,
            UniteEnseignementId = item.UniteEnseignementId,
            UniteEnseignementLibelle = item.UniteEnseignementLibelle,
            Code = item.Code,
            Libelle = item.Libelle,
            Type = item.Type,
            Credits = item.Credits,
            VolumeHoraire = item.VolumeHoraire
        };
        formUniteEnseignementId = item.UniteEnseignementId;
        formType = item.Type;
        formCredits = item.Credits;
        formVolumeHoraire = item.VolumeHoraire;
        codeWasManuallyEdited = true;
        showForm = true;
    }

    private async Task OnLibelleInput(ChangeEventArgs args)
    {
        model.Libelle = args.Value?.ToString() ?? string.Empty;

        if (!codeWasManuallyEdited)
        {
            await UpdateGeneratedCodeAsync();
        }
    }

    private void OnCodeInput(ChangeEventArgs args)
    {
        model.Code = args.Value?.ToString();
        codeWasManuallyEdited = true;
    }

    private async Task OnFormUniteEnseignementChanged(object? _)
    {
        if (!codeWasManuallyEdited)
        {
            await UpdateGeneratedCodeAsync();
        }
    }

    private async Task UpdateGeneratedCodeAsync()
    {
        if (formUniteEnseignementId is null || string.IsNullOrWhiteSpace(model.Libelle))
        {
            model.Code = string.Empty;
            return;
        }

        model.Code = await ProgrammeService.GenerateElementConstitutifCodeAsync(
            formUniteEnseignementId.Value,
            model.Libelle,
            model.Id);
    }

    private async Task Save(ElementConstitutifDto _)
    {
        try
        {
            if (formUniteEnseignementId is null || formUniteEnseignementId <= 0)
            {
                NotifyError("L'UE de l'EC est obligatoire.");
                return;
            }

            if (formType is null)
            {
                NotifyError("Le type de l'EC est obligatoire.");
                return;
            }

            model.UniteEnseignementId = formUniteEnseignementId.Value;
            model.Type = formType.Value;
            model.Credits = formCredits ?? 0m;
            model.VolumeHoraire = formVolumeHoraire ?? 0;
            await ProgrammeService.SaveElementConstitutifAsync(model);
            NotifySuccess();
            showForm = false;
            await LoadLookups();
            await Load();
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
    }

    private async Task Delete(ElementConstitutifDto item)
    {
        try
        {
            await ProgrammeService.DeleteElementConstitutifAsync(item.Id);
            await Load();
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
    }

    private void Cancel() => showForm = false;
    private void NotifySuccess() => NotificationService.Notify(NotificationSeverity.Success, "Succès", "Données enregistrées.");
    private void NotifyError(string message) => NotificationService.Notify(NotificationSeverity.Error, "Erreur", message);

    private record EnumOption<TValue>(string Text, TValue Value);
}
