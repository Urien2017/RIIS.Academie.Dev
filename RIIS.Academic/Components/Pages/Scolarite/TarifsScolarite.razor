@page "/scolarite/tarifs"
@inject ITarifsScolariteService TarifsScolariteService
@inject ITypesElementsScolariteService TypesElementsScolariteService
@inject IReferentielsService ReferentielsService
@inject NotificationService NotificationService

<RadzenStack Gap="1rem">
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
            <RadzenStack Gap="0">
                <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0" Text="Tarifs scolarité" />
                <RadzenText Text="Configuration des montants par type d'élément et parcours académique." />
            </RadzenStack>
            <RadzenButton Text="Nouveau tarif" Icon="add_circle" Click="@Create" ButtonStyle="ButtonStyle.Primary" Disabled="@(typeElements.Count == 0 || parcours.Count == 0)" />
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenText TextStyle="TextStyle.H6" Text="Filtres" />
            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Type d'élément" Style="width:100%">
                        <RadzenDropDown AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Data="@typeElements"
                                        @bind-Value="@filtreTypeElementId"
                                        TextProperty="Libelle"
                                        ValueProperty="Id"
                                        TValue="long?"
                                        AllowClear="true"
                                        Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Parcours académique" Style="width:100%">
                        <RadzenDropDown AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Data="@parcours"
                                        @bind-Value="@filtreParcoursAcademiqueId"
                                        TextProperty="Libelle"
                                        ValueProperty="Id"
                                        TValue="long?"
                                        AllowClear="true"
                                        Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="2">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="height:100%">
                        <RadzenCheckBox @bind-Value="@inclureInactifs" />
                        <RadzenText Text="Inclure inactifs" />
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="2">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" JustifyContent="JustifyContent.End" Gap="0.5rem" Style="height:100%">
                        <RadzenButton Text="Filtrer" Icon="search" ButtonStyle="ButtonStyle.Primary" Click="@LoadTarifs" Disabled="@tarifsLoading" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>
    </RadzenCard>

    @if (typeElements.Count == 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" ShowIcon="true">
            Créez d'abord au moins un type d'élément scolarité avant de configurer les tarifs.
        </RadzenAlert>
    }

    @if (parcours.Count == 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" ShowIcon="true">
            Créez d'abord au moins un parcours académique avant de configurer les tarifs.
        </RadzenAlert>
    }

    @if (showForm)
    {
        <div class="riis-modal-backdrop">
            <RadzenCard class="riis-modal">
            <RadzenTemplateForm TItem="TarifScolariteDto" Data="@model" Submit="@Save">
                <RadzenStack Gap="1rem">
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="riis-modal-title rz-m-0">@(model.Id == 0 ? "Nouveau tarif" : "Modifier le tarif")</RadzenText>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenFormField Text="Type d'élément" Style="width:100%">
                                <RadzenDropDown AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Data="@TypesElementsDisponibles"
                                                @bind-Value="@model.TypeElementScolariteId"
                                                Change="@OnTypeElementChanged"
                                                TextProperty="Libelle"
                                                ValueProperty="Id"
                                                TValue="long"
                                                Name="TypeElementScolariteId"
                                                Style="width:100%" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="TypeElementScolariteId" Text="Type d'élément obligatoire." />
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="Parcours académique" Style="width:100%">
                                <RadzenDropDown AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Data="@ParcoursDisponibles"
                                                @bind-Value="@model.ParcoursAcademiqueId"
                                                Change="@OnParcoursChanged"
                                                TextProperty="Libelle"
                                                ValueProperty="Id"
                                                TValue="long"
                                                Name="ParcoursAcademiqueId"
                                                Style="width:100%" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="ParcoursAcademiqueId" Text="Parcours obligatoire." />
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeMD="2">
                            <RadzenFormField Text="Montant" Style="width:100%">
                                <RadzenNumeric @bind-Value="@model.Montant"
                                               Name="Montant"
                                               Min="1"
                                               Step="1000"
                                               Format="N0"
                                               Style="width:100%" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="Montant" Text="Montant obligatoire." />
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeMD="2">
                            <RadzenFormField Text="Devise" Style="width:100%">
                                <RadzenTextBox @bind-Value="@model.Devise" Name="Devise" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="Devise" Text="Devise obligatoire." />
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="2">
                            <RadzenFormField Text="Priorité" Style="width:100%">
                                <RadzenNumeric @bind-Value="@model.Priorite" />
                            </RadzenFormField>
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenFormField Text="Date de notification" Style="width:100%">
                                <RadzenDatePicker TValue="DateTime?"
                                                  Value="@DateNotificationValue"
                                                  Change="@OnDateNotificationChanged"
                                                  DateFormat="dd/MM/yyyy"
                                                  Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeMD="2">
                            <RadzenLabel Text="Actif" />
                            <RadzenCheckBox @bind-Value="@model.EstActif" />
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                        <RadzenButton Text="Annuler" Icon="close" ButtonStyle="ButtonStyle.Light" Click="@Cancel" />
                        <RadzenButton Text="Enregistrer" Icon="save" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenTemplateForm>
            </RadzenCard>
        </div>
    }

    <RadzenCard>
        <RadzenDataGrid @ref="tarifsGrid" Data="@items" TItem="TarifScolariteDto" AllowPaging="true" AllowSorting="true" AllowColumnResize="true" AllowFiltering="true" PageSize="10">
            <Columns>
                <RadzenDataGridColumn TItem="TarifScolariteDto" Property="Code" Title="Code" Width="140px" />
                <RadzenDataGridColumn TItem="TarifScolariteDto" Property="TypeElementScolariteLibelle" Title="Type d'élément" />
                <RadzenDataGridColumn TItem="TarifScolariteDto" Property="ParcoursAcademiqueLibelle" Title="Parcours" />
                <RadzenDataGridColumn TItem="TarifScolariteDto" Title="Montant" Width="150px" TextAlign="TextAlign.Right">
                    <Template Context="item">
                        <RadzenText Text="@($"{item.Montant:N0} {item.Devise}")" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TarifScolariteDto" Title="Notification" Width="130px">
                    <Template Context="item">
                        @(item.DateNotification?.ToString("dd/MM/yyyy") ?? "Aucune")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TarifScolariteDto" Property="Priorite" Title="Priorité" Width="110px" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn TItem="TarifScolariteDto" Property="EstActif" Title="Actif" Width="100px">
                    <Template Context="item"><RadzenCheckBox Value="@item.EstActif" Disabled="true" /></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TarifScolariteDto" Title="Actions" Width="160px" Sortable="false" Filterable="false">
                    <Template Context="item">
                        <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => Edit(item))" />
                        <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Click="@(() => Delete(item))" class="rz-ml-1" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</RadzenStack>

@code {
    private List<TypeElementScolariteDto> typeElements = [];
    private List<ParcoursAcademiqueDto> parcours = [];
    private List<TarifScolariteDto> tarifsExistants = [];
    private List<TarifScolariteDto> items = [];
    private RadzenDataGrid<TarifScolariteDto>? tarifsGrid;
    private TarifScolariteDto model = new();
    private long? filtreTypeElementId;
    private long? filtreParcoursAcademiqueId;
    private bool inclureInactifs;
    private bool showForm;
    private readonly SemaphoreSlim tarifsLoadGate = new(1, 1);
    private bool tarifsLoading;

    private DateTime? DateNotificationValue => model.DateNotification?.ToDateTime(TimeOnly.MinValue);

    protected override async Task OnInitializedAsync()
    {
        parcours = await ReferentielsService.GetParcoursAcademiquesAsync(inclureInactifs: true);
        typeElements = await TypesElementsScolariteService.GetTypesElementsScolariteAsync(inclureInactifs: true);
        await LoadTarifs();
    }

    private async Task LoadTarifs()
    {
        await tarifsLoadGate.WaitAsync();
        tarifsLoading = true;

        try
        {
            // Un seul appel EF est necessaire. Les filtres sont appliques apres
            // le chargement pour eviter deux requetes concurrentes au meme moment.
            tarifsExistants = await TarifsScolariteService.GetTarifsScolariteAsync(
                inclureInactifs: true);

            items = tarifsExistants
                .Where(x => inclureInactifs || x.EstActif)
                .Where(x => filtreTypeElementId is null
                    || x.TypeElementScolariteId == filtreTypeElementId)
                .Where(x => filtreParcoursAcademiqueId is null
                    || x.ParcoursAcademiqueId == filtreParcoursAcademiqueId)
                .ToList();

            if (tarifsGrid is not null)
            {
                await tarifsGrid.Reload();
            }
        }
        finally
        {
            tarifsLoading = false;
            tarifsLoadGate.Release();
        }
    }

    private void Create()
    {
        model = TarifsScolariteService.CreateDefaultTarifScolarite(filtreTypeElementId);
        model.ParcoursAcademiqueId = filtreParcoursAcademiqueId ?? 0;

        if (model.TypeElementScolariteId > 0
            && model.ParcoursAcademiqueId > 0
            && !IsCombinationAvailable(model.TypeElementScolariteId, model.ParcoursAcademiqueId))
        {
            model.TypeElementScolariteId = 0;
            model.ParcoursAcademiqueId = 0;
        }

        showForm = true;
    }

    private void Edit(TarifScolariteDto item)
    {
        model = new TarifScolariteDto
        {
            Id = item.Id,
            Code = item.Code,
            TypeElementScolariteId = item.TypeElementScolariteId,
            TypeElementScolariteCode = item.TypeElementScolariteCode,
            TypeElementScolariteLibelle = item.TypeElementScolariteLibelle,
            ParcoursAcademiqueId = item.ParcoursAcademiqueId,
            ParcoursAcademiqueLibelle = item.ParcoursAcademiqueLibelle,
            Montant = item.Montant,
            Devise = item.Devise,
            DateNotification = item.DateNotification,
            Priorite = item.Priorite,
            EstActif = item.EstActif
        };
        showForm = true;
    }

    private async Task Save(TarifScolariteDto _)
    {
        try
        {
            await TarifsScolariteService.SaveTarifScolariteAsync(model);
            NotifySuccess();
            showForm = false;
            await LoadTarifs();
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
    }

    private async Task Delete(TarifScolariteDto item)
    {
        try
        {
            await TarifsScolariteService.DeleteTarifScolariteAsync(item.Id);
            await LoadTarifs();
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
    }

    private void Cancel() => showForm = false;

    private IEnumerable<TypeElementScolariteDto> TypesElementsDisponibles
        => model.ParcoursAcademiqueId <= 0
            ? typeElements
            : typeElements.Where(x =>
                x.Id == model.TypeElementScolariteId
                || IsCombinationAvailable(x.Id, model.ParcoursAcademiqueId));

    private IEnumerable<ParcoursAcademiqueDto> ParcoursDisponibles
        => model.TypeElementScolariteId <= 0
            ? parcours
            : parcours.Where(x =>
                x.Id == model.ParcoursAcademiqueId
                || IsCombinationAvailable(model.TypeElementScolariteId, x.Id));

    private bool IsCombinationAvailable(long typeElementScolariteId, long parcoursAcademiqueId)
        => typeElementScolariteId > 0
            && parcoursAcademiqueId > 0
            && !tarifsExistants.Any(x =>
                x.Id != model.Id
                && x.TypeElementScolariteId == typeElementScolariteId
                && x.ParcoursAcademiqueId == parcoursAcademiqueId);

    private void OnTypeElementChanged(object? _)
    {
        if (model.TypeElementScolariteId > 0
            && model.ParcoursAcademiqueId > 0
            && !IsCombinationAvailable(model.TypeElementScolariteId, model.ParcoursAcademiqueId))
        {
            model.ParcoursAcademiqueId = 0;
        }
    }

    private void OnParcoursChanged(object? _)
    {
        if (model.TypeElementScolariteId > 0
            && model.ParcoursAcademiqueId > 0
            && !IsCombinationAvailable(model.TypeElementScolariteId, model.ParcoursAcademiqueId))
        {
            model.TypeElementScolariteId = 0;
        }
    }

    private void OnDateNotificationChanged(DateTime? value)
        => model.DateNotification = value is null ? null : DateOnly.FromDateTime(value.Value);

    private void NotifySuccess() => NotificationService.Notify(NotificationSeverity.Success, "Succès", "Données enregistrées.");
    private void NotifyError(string message) => NotificationService.Notify(NotificationSeverity.Error, "Erreur", message);
}
