@inherits LayoutComponentBase

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" class="rz-px-2 rz-py-2">
            <RadzenSidebarToggle Click="@ToggleSidebar" />
            <RadzenStack Gap="0">
                <RadzenText TextStyle="TextStyle.H6" class="rz-m-0" Text="RIIS Academic" />
                <RadzenText TextStyle="TextStyle.Caption" Text="Gestion des inscriptions, notes, PV et relevés" />
            </RadzenStack>
        </RadzenStack>
    </RadzenHeader>

    <SideBarNav sidebarExpanded="@sidebarExpanded" />

    <RadzenBody>
        @Body
    </RadzenBody>
</RadzenLayout>

@code {
    private bool sidebarExpanded = true;

    private void ToggleSidebar()
    {
        sidebarExpanded = !sidebarExpanded;
    }
}
